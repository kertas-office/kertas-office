+/* Kertas Office look for the spreadsheet editor: the shared skin plus Kertas's
+ * Sheets green. Loaded last so it wins. */
+@import '../../../../kertas-skin.css';
+
+:root {
+  --kertas-grad: linear-gradient(135deg, #10b981 0%, #059669 50%, #14b8a6 100%);
+  --kertas-grad-shadow: rgb(5 150 105 / 35%);
+  --excel-green: #059669;
+  --excel-green-dark: #047857;
+  --excel-green-soft: #dff5ec;
+  --accent: #059669;
+  --accent-dark: #047857;
+  --accent-soft: #dff5ec;
+  --focus: rgb(5 150 105 / 24%);
+  --ribbon-hover: var(--hover);
+  --ribbon-active: var(--pressed);
+  --surface-hover: var(--hover);
+}
+
+[data-theme='dark'] {
+  --accent: #34d399;
+  --accent-dark: #6ee7b7;
+  --accent-soft: #12332a;
+  --ribbon-hover: var(--hover);
+  --ribbon-active: var(--pressed);
+  --surface-hover: var(--hover);
+}
+
+/* the tab row and the ribbon band on the same light grey as the Writer and PDF ribbons */
+.excel-header,
+.excel-header .ribbon-tabs,
+.excel-header .ribbon {
+  background: var(--chrome-bg);
+}
