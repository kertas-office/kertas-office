--- /dev/null
+++ b/apps/docs/kertas.vite.config.ts
@@ -0,0 +1,58 @@
+import { resolve } from 'node:path'
+import react from '@vitejs/plugin-react'
+import { defineConfig, externalizeDepsPlugin } from 'electron-vite'
+import type { Plugin } from 'vite'
+import { type AiModules, kertasAssetNames, kertasNoAi as noAiPlugin, kertasNoAiBridge, kertasNoAiMain, kertasNoAiStrings } from '../kertas-build'
+
+// Build used when Kertas Office hosts this editor. Same sources as the normal
+// build; the main-process entry exports the hosting functions instead of
+// starting an app, and everything except electron is bundled in.
+const localAlias = {
+  '@genoffice/docx-engine/lazy-media': resolve(__dirname, '../../packages/docx-engine/src/lazy-media.ts'),
+  '@genoffice/docx-engine/zip-splice': resolve(__dirname, '../../packages/docx-engine/src/zip-splice.ts'),
+  '@genoffice/docx-engine': resolve(__dirname, '../../packages/docx-engine/src/index.ts'),
+}
+
+const noAi = resolve(__dirname, 'src/renderer/kertas/no-ai')
+const AI_MODULES: AiModules = [
+  [/(^|\/)ai\/AiPanel$/, 'AiPanel.tsx'],
+  [/(^|\/)components\/AiAskPopover$|^\.\/AiAskPopover$/, 'AiAskPopover.tsx'],
+  [/(^|\/)mcp-bridge$/, 'mcp-bridge.ts'],
+  [/(^|\/)ai\/tools$/, 'tools.ts'],
+]
+const kertasNoAi = (): Plugin => noAiPlugin(noAi, AI_MODULES)
+
+export default defineConfig({
+  main: {
+    plugins: [kertasNoAi(), kertasNoAiStrings(), kertasNoAiMain()],
+    resolve: { alias: localAlias },
+    build: {
+      externalizeDeps: false,
+      outDir: 'out-kertas/main',
+      rollupOptions: {
+        input: {
+          index: resolve(__dirname, 'src/main/kertas-entry.ts'),
+          pdf2docx: resolve(__dirname, 'src/main/kertas-pdf-entry.ts'),
+        },
+        external: ['electron', /^node:/],
+        output: { format: 'cjs', entryFileNames: '[name].cjs', chunkFileNames: '[name]-[hash].cjs' },
+      },
+    },
+  },
+  preload: {
+    plugins: [kertasNoAi(), kertasNoAiBridge(), externalizeDepsPlugin({ exclude: ['@genoffice/electron-utils'] })],
+    build: { outDir: 'out-kertas/preload' },
+  },
+  renderer: {
+    plugins: [kertasNoAi(), kertasNoAiStrings(), react()],
+    resolve: { alias: localAlias },
+    build: {
+      outDir: 'out-kertas/renderer',
+      rollupOptions: {
+        output: {
+          assetFileNames: kertasAssetNames,
+        },
+      },
+    },
+  },
+})
