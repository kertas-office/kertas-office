+/* Kertas Office look for the editor: Kertas's own font, colours and shapes laid
+ * over the editor's tokens. Loaded last so it wins; document content (the page,
+ * its text and pictures) is untouched. The two Inter files are copied in by
+ * Kertas's build script (scripts/build-writer2.cjs). */
+@font-face {
+  font-family: 'Inter Variable';
+  font-style: normal;
+  font-display: swap;
+  font-weight: 100 900;
+  src: url('./inter-latin-ext-wght-normal.woff2') format('woff2-variations');
+  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308,
+    U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
+    U+2C60-2C7F, U+A720-A7FF;
+}
+@font-face {
+  font-family: 'Inter Variable';
+  font-style: normal;
+  font-display: swap;
+  font-weight: 100 900;
+  src: url('./inter-latin-wght-normal.woff2') format('woff2-variations');
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304,
+    U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
+}
+
+:root {
+  --kertas-font: 'Inter Variable', 'Segoe UI Variable', 'Segoe UI', system-ui, -apple-system, sans-serif;
+  --kertas-grad-writer: linear-gradient(135deg, #3b82f6 0%, #2563eb 50%, #06b6d4 100%);
+
+  --word-blue: #2563eb;
+  --word-blue-dark: #1d4ed8;
+  --accent: #2563eb;
+  --accent-dark: #1d4ed8;
+  --accent-soft: #e3ebfd;
+  --docs-accent-ghost: rgb(37 99 235 / 10%);
+
+  --surface: #ffffff;
+  --surface-subtle: #f6f8fc;
+  --chrome-bg: #f6f8fc;
+  --canvas: #e7eaf1;
+  --border: #e2e6ee;
+  --border-subtle: #eceff5;
+  --border-strong: #d5dae4;
+  --border-hover: #c5ccd9;
+  --text: #0f172a;
+  --text-primary: #0f172a;
+  --text-secondary: #334155;
+  --text-tertiary: #64748b;
+  --text-muted: #64748b;
+  --text-dim: #475569;
+  --hover: #e9edf5;
+  --pressed: #dde3ee;
+  --active-bg: #e3ebfd;
+  --bg-hover: #e9edf5;
+  --bg-hover-subtle: #eef1f7;
+  --bg-hover-strong: #dde3ee;
+  --bg-content: #f6f8fc;
+  --icon-muted: #94a3b8;
+  --shadow-menu: 0 10px 30px -12px rgb(15 23 42 / 25%), 0 2px 6px rgb(15 23 42 / 6%);
+}
+
+[data-theme='dark'] {
+  --word-blue: #60a5fa;
+  --word-blue-dark: #3b82f6;
+  --accent: #60a5fa;
+  --accent-dark: #3b82f6;
+  --accent-soft: #1c2a4a;
+  --docs-accent-ghost: rgb(96 165 250 / 14%);
+
+  --surface: #151a27;
+  --surface-subtle: #1a2030;
+  --chrome-bg: #111624;
+  --canvas: #0f1420;
+  --border: #252c3d;
+  --border-subtle: #1e2534;
+  --border-strong: #2f384c;
+  --border-hover: #3a4459;
+  --text: #e8ecf5;
+  --text-primary: #e8ecf5;
+  --text-secondary: #c3cad8;
+  --text-tertiary: #8a94a8;
+  --text-muted: #8a94a8;
+  --text-dim: #a5aec0;
+  --hover: #1f2637;
+  --pressed: #283044;
+  --active-bg: #1c2a4a;
+  --bg-hover: #1f2637;
+  --bg-hover-subtle: #1a2030;
+  --bg-hover-strong: #283044;
+  --bg-content: #111624;
+  --icon-muted: #5b657a;
+}
+
+body,
+button,
+input,
+select,
+textarea {
+  font-family: var(--kertas-font);
+}
+
+/* Kertas's tab strip is the window's title bar; this row is not a drag area */
+.ribbon-tabs {
+  -webkit-app-region: no-drag;
+  padding: 6px 10px 0;
+}
+
+.ribbon {
+  border-bottom-color: var(--border);
+}
+
+.ribbon-tab {
+  font-weight: 500;
+  border-radius: 6px 6px 0 0;
+}
+
+.ribbon-tab.active {
+  font-weight: 600;
+}
+
+/* the File button, as in the rest of Kertas: gradient pill */
+.ribbon-tab-file {
+  background: var(--kertas-grad-writer);
+  border-radius: 9px;
+  border-bottom: none;
+  padding: 6px 15px;
+  font-weight: 600;
+  box-shadow: 0 1px 2px rgb(37 99 235 / 35%);
+}
+
+.ribbon-tab-file:hover,
+.ribbon-tab-file.open {
+  background: var(--kertas-grad-writer);
+  filter: brightness(1.07);
+}
+
+.file-menu,
+.rb-font-family-menu,
+.rb-font-size-menu {
+  border-radius: 10px;
+  border-color: var(--border);
+}
+
+.rb-big,
+.rb-small,
+.rb-icon,
+.rb-select {
+  border-radius: 7px;
+}
+
+.status-bar {
+  height: 26px;
+}
+
+/* ---- form fields (kertas/form-fields.ts) ---- */
+.doc-field-control {
+  background: rgb(37 99 235 / 8%);
+  border-radius: 3px;
+  box-shadow: 0 0 0 1px rgb(37 99 235 / 22%);
+  padding: 0 2px;
+  cursor: text;
+}
+
+.doc-field-control[data-ctrl-field='list'],
+.doc-field-control[data-ctrl-field='date'] {
+  cursor: pointer;
+}
+
+.doc-field-control[data-ctrl-field='list']::after {
+  content: ' \25BE';
+  color: #2563eb;
+}
+
+.doc-field-control:hover {
+  box-shadow: 0 0 0 1px rgb(37 99 235 / 55%);
+}
+
+@media print {
+  .doc-field-control {
+    background: none;
+    box-shadow: none;
+  }
+
+  .doc-field-control[data-ctrl-field='list']::after {
+    content: none;
+  }
+}
+
+.kertas-field-popup {
+  position: fixed;
+  z-index: 5000;
+  min-width: 180px;
+  max-width: 320px;
+  max-height: 300px;
+  overflow: auto;
+  padding: 5px;
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  box-shadow: var(--shadow-menu);
+  font: 13px var(--kertas-font);
+}
+
+.kertas-field-popup button {
+  display: block;
+  width: 100%;
+  padding: 6px 10px;
+  border: none;
+  border-radius: 6px;
+  background: none;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.kertas-field-popup button:hover {
+  background: var(--hover);
+}
+
+.kertas-field-popup button.is-current {
+  background: var(--accent-soft);
+  font-weight: 600;
+}
+
+.kertas-field-popup button.is-clear {
+  margin-top: 4px;
+  border-top: 1px solid var(--border-subtle);
+  border-radius: 0 0 6px 6px;
+  color: var(--text-tertiary);
+}
+
+.kertas-field-empty {
+  padding: 8px 10px;
+  color: var(--text-tertiary);
+}
+
+.kertas-field-date {
+  display: flex;
+  gap: 6px;
+  align-items: center;
+  padding: 8px;
+  max-width: none;
+}
+
+.kertas-field-date input,
+.kertas-field-dialog input,
+.kertas-field-dialog textarea,
+.kertas-field-dialog select {
+  padding: 6px 8px;
+  border: 1px solid var(--border-strong);
+  border-radius: 7px;
+  background: var(--surface);
+  color: var(--text);
+  font: 13px var(--kertas-font);
+}
+
+.kertas-field-date button {
+  width: auto;
+  white-space: nowrap;
+}
+
+.kertas-field-popup button.is-primary,
+.kertas-field-dialog button.is-primary {
+  background: var(--accent);
+  color: #ffffff;
+}
+
+.kertas-field-dialog-back {
+  position: fixed;
+  inset: 0;
+  z-index: 6000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgb(15 23 42 / 35%);
+}
+
+.kertas-field-dialog {
+  width: 420px;
+  max-width: calc(100vw - 32px);
+  padding: 18px 20px;
+  background: var(--surface);
+  color: var(--text);
+  border-radius: 14px;
+  box-shadow: 0 24px 60px -20px rgb(15 23 42 / 45%);
+  font: 13px var(--kertas-font);
+}
+
+.kertas-field-dialog h3 {
+  margin: 0 0 4px;
+  font-size: 16px;
+}
+
+.kertas-field-dialog p {
+  margin: 0 0 12px;
+  color: var(--text-tertiary);
+}
+
+.kertas-field-dialog label {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  margin-bottom: 11px;
+  font-weight: 500;
+}
+
+.kertas-field-dialog textarea {
+  resize: vertical;
+}
+
+.kertas-field-error {
+  min-height: 16px;
+  color: #dc2626;
+}
+
+.kertas-field-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 6px;
+}
+
+.kertas-field-actions button {
+  padding: 7px 14px;
+  border: 1px solid var(--border-strong);
+  border-radius: 8px;
+  background: var(--surface);
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+.kertas-field-actions button.is-primary {
+  border-color: transparent;
+}
+
+/* ---- slash menu (kertas/slash-menu.ts) ---- */
+.kertas-slash {
+  position: fixed;
+  z-index: 5000;
+  width: 290px;
+  max-height: 320px;
+  display: flex;
+  flex-direction: column;
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  box-shadow: var(--shadow-menu);
+  font: 13px var(--kertas-font);
+  overflow: hidden;
+}
+
+.kertas-slash-search {
+  margin: 8px 8px 4px;
+  padding: 7px 9px;
+  border: 1px solid var(--border-strong);
+  border-radius: 8px;
+  background: var(--surface);
+  color: var(--text);
+  font: inherit;
+  outline: none;
+}
+
+.kertas-slash-list {
+  overflow: auto;
+  padding: 5px;
+}
+
+.kertas-slash-group {
+  padding: 7px 9px 3px;
+  color: var(--text-tertiary);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.kertas-slash-item {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  width: 100%;
+  padding: 6px 9px;
+  border: none;
+  border-radius: 7px;
+  background: none;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.kertas-slash-item strong {
+  font-weight: 550;
+}
+
+.kertas-slash-item span {
+  color: var(--text-tertiary);
+  font-size: 12px;
+}
+
+.kertas-slash-item.is-active {
+  background: var(--accent-soft);
+}
+
+.kertas-slash-none {
+  padding: 10px;
+  color: var(--text-tertiary);
+}
+
+/* ---- rulers: margins and header / footer distance are dragged on them ---- */
+.vruler-margin-handle:hover::after,
+.ruler-margin-handle:hover::after {
+  content: '';
+  position: absolute;
+  inset: 2px 0;
+  background: var(--accent);
+  opacity: 0.55;
+  border-radius: 2px;
+}
+
+.vruler-edge-handle {
+  position: absolute;
+  left: 3px;
+  right: 3px;
+  height: 9px;
+  transform: translateY(-50%);
+  cursor: row-resize;
+  z-index: 3;
+}
+
+.vruler-edge-handle::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 3px;
+  height: 3px;
+  border-radius: 2px;
+  background: var(--accent);
+  opacity: 0.75;
+}
+
+.vruler-edge-handle:hover::before {
+  opacity: 1;
+  top: 2px;
+  height: 5px;
+}
+
+.vruler-edge-handle:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+/* ==== Kertas ribbon (the same in Writer, Sheets and PDF) ====
+ * Softer ink than the document text, as Kertas's own ribbon had: slate tools and labels,
+ * muted tab names, the app colour on the open tab. Every large button is the same height,
+ * with its icon in the same place and room for a two-line caption, so a row of buttons
+ * lines up whatever their captions. */
+:root {
+  --kertas-rb-ink: #475569;
+  --kertas-rb-ink-strong: #334155;
+  --kertas-rb-tab: #64748b;
+  --kertas-rb-line: #e1e6ef;
+}
+
+[data-theme='dark'] {
+  --kertas-rb-ink: #b4bdcc;
+  --kertas-rb-ink-strong: #d3d9e4;
+  --kertas-rb-tab: #8a94a8;
+  --kertas-rb-line: #283043;
+}
+
+/* the ribbon draws with the softer ink */
+.ribbon,
+.excel-header {
+  --text: var(--kertas-rb-ink);
+  --text-primary: var(--kertas-rb-ink);
+  --color-text-primary: var(--kertas-rb-ink);
+  --text-secondary: var(--kertas-rb-ink);
+  color: var(--kertas-rb-ink);
+}
+
+/* typed values (font name, size, page number) stay easy to read */
+.ribbon input,
+.ribbon select,
+.excel-header input,
+.excel-header select,
+.ribbon .rb-select,
+.excel-header .select-like {
+  color: var(--kertas-rb-ink-strong);
+}
+
+/* tab names: muted, the open one in the app's colour */
+.ribbon-tab:not(.ribbon-tab-file),
+.ribbon-tabs > button:not(.qa-btn) {
+  color: var(--kertas-rb-tab);
+  font-weight: 550;
+}
+
+.ribbon-tab:not(.ribbon-tab-file):hover,
+.ribbon-tabs > button:not(.qa-btn):hover {
+  color: var(--kertas-rb-ink-strong);
+}
+
+.ribbon-tab.active,
+.ribbon-tabs > button:not(.qa-btn).active {
+  color: var(--accent);
+  font-weight: 600;
+}
+
+/* group separators: one quiet line, the same inset everywhere */
+.ribbon-sep {
+  background: var(--kertas-rb-line);
+  margin: 6px 6px;
+}
+
+.ribbon-group::after {
+  background: var(--kertas-rb-line);
+  top: 6px;
+  bottom: 6px;
+}
+
+/* ---- large buttons: one height, icon on top, caption below ---- */
+.rb-big:not(.rb-big-split > .rb-big),
+.ribbon-tool.large {
+  justify-content: flex-start;
+  gap: 3px;
+  height: 64px;
+  padding: 3px 6px 2px;
+  min-width: 52px;
+  max-width: 96px;
+  white-space: normal;
+}
+
+.rb-big-icon,
+.ribbon-tool.large .tool-icon-row {
+  flex: none;
+  min-height: 30px;
+  height: 30px;
+  align-self: stretch;
+}
+
+/* the caption: up to two lines, always the room of two, centred */
+.rb-big:not(.rb-big-split > .rb-big) > span:not(.rb-big-icon),
+.ribbon-tool.large > span:not(.tool-icon-row),
+.ribbon-tool.large strong {
+  display: block;
+  min-height: 26px;
+  line-height: 13px;
+  font-size: 11.5px;
+  font-weight: 450;
+  text-align: center;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
+
+/* small buttons and icon buttons keep their size; only their ink softens */
+.rb-small svg,
+.rb-icon svg,
+.ribbon-tool:not(.large) svg {
+  color: var(--kertas-rb-ink);
+}
+
+/* the split Paste button: a tall icon, then its caption as the drop-down part */
+.rb-big-split {
+  height: 64px;
+  justify-content: flex-start;
+}
+
+.rb-big-split > .rb-big {
+  padding-bottom: 0;
+}
+
+.rb-big-split-caret {
+  font-size: 11.5px;
+}
diff --git a/apps/docs/src/renderer/kertas/slash-menu.ts b/apps/docs/src/renderer/kertas/slash-menu.ts
new file mode 100644
index 0000000..ac5bcf6
--- /dev/null
+++ b/apps/docs/src/renderer/kertas/slash-menu.ts
@@ -0,0 +1,285 @@
+// Kertas Office: slash commands. Type "/" at the start of a line (or after a
+// space) and a menu of blocks and actions opens at the cursor. Keep typing to
+// filter, arrows and Enter to choose, Esc to leave the text as typed. Ctrl+/
+// opens the same menu anywhere.
+
+import { Extension, type Editor } from '@tiptap/core'
+import { Plugin } from '@tiptap/pm/state'
+import type { EditorView } from '@tiptap/pm/view'
+import { insertFormField } from './form-fields'
+
+/** runs one of the editor's own commands (the ribbon's); set by the app once it is ready */
+let run: (id: string, payload?: string) => void = () => {}
+export function setSlashCommandRunner(fn: (id: string, payload?: string) => void): void {
+  run = fn
+}
+
+interface SlashCommand {
+  id: string
+  group: string
+  label: string
+  hint: string
+  keys?: string[]
+  run: (editor: Editor) => void
+}
+
+const cmd = (id: string, payload?: string) => () => run(id, payload)
+const today = (): string => new Date().toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' })
+
+const COMMANDS: SlashCommand[] = [
+  { id: 'text', group: 'Text', label: 'Text', keys: ['normal', 'paragraph', 'body', 'p'], hint: 'Plain body text', run: cmd('apply-style', 'Normal') },
+  { id: 'h1', group: 'Text', label: 'Heading 1', keys: ['h1', 'title section'], hint: 'Big section heading', run: cmd('apply-style', 'Heading1') },
+  { id: 'h2', group: 'Text', label: 'Heading 2', keys: ['h2', 'subheading'], hint: 'Medium heading', run: cmd('apply-style', 'Heading2') },
+  { id: 'h3', group: 'Text', label: 'Heading 3', keys: ['h3'], hint: 'Small heading', run: cmd('apply-style', 'Heading3') },
+  { id: 'title', group: 'Text', label: 'Title', keys: ['document title'], hint: 'Document title', run: cmd('apply-style', 'Title') },
+  { id: 'quote', group: 'Text', label: 'Quote', keys: ['blockquote', 'citation text'], hint: 'Quoted passage', run: cmd('apply-style', 'Quote') },
+  { id: 'bullets', group: 'Lists', label: 'Bulleted list', keys: ['ul', 'bullet', 'unordered', '-'], hint: 'A simple list', run: cmd('bullets') },
+  { id: 'numbers', group: 'Lists', label: 'Numbered list', keys: ['ol', 'ordered', '1.', 'steps'], hint: '1, 2, 3', run: cmd('numbering') },
+  { id: 'tick', group: 'Lists', label: 'Tick box', keys: ['checkbox', 'todo', 'checklist', 'task'], hint: 'A box to tick later', run: (e) => void insertFormField(e, 'checkbox') },
+  { id: 'f-text', group: 'Forms', label: 'Text field', keys: ['form', 'field', 'input', 'fill in'], hint: 'A box to type in', run: (e) => void insertFormField(e, 'text') },
+  { id: 'f-drop', group: 'Forms', label: 'Dropdown list', keys: ['form', 'select', 'choices', 'combo'], hint: 'Pick one of your choices', run: (e) => void insertFormField(e, 'list') },
+  { id: 'f-date', group: 'Forms', label: 'Date picker', keys: ['form', 'calendar', 'date field'], hint: 'Pick a date from a calendar', run: (e) => void insertFormField(e, 'date') },
+  { id: 'table', group: 'Insert', label: 'Table', keys: ['grid', 'rows', 'columns'], hint: 'Rows and columns', run: cmd('insert-table') },
+  { id: 'picture', group: 'Insert', label: 'Picture', keys: ['image', 'photo', 'img'], hint: 'From your computer', run: cmd('insert-image') },
+  { id: 'divider', group: 'Insert', label: 'Divider', keys: ['line', 'hr', 'rule', 'separator'], hint: 'Horizontal line', run: cmd('insert-horizontal-line') },
+  { id: 'pagebreak', group: 'Insert', label: 'Page break', keys: ['new page', 'break'], hint: 'Start a new page', run: cmd('insert-page-break') },
+  { id: 'link', group: 'Insert', label: 'Link', keys: ['url', 'hyperlink', 'web'], hint: 'Web address or place in the document', run: cmd('insert-link') },
+  { id: 'date', group: 'Insert', label: 'Date', keys: ['today', 'time'], hint: "Today's date", run: (e) => void e.chain().focus().insertContent(today()).run() },
+  { id: 'comment', group: 'Insert', label: 'Comment', keys: ['note', 'review'], hint: 'Comment here', run: cmd('insert-comment') },
+  { id: 'equation', group: 'Insert', label: 'Equation', keys: ['math', 'formula', 'latex'], hint: 'Fractions, roots, sums', run: cmd('insert-equation') },
+  { id: 'textbox', group: 'Insert', label: 'Text box', keys: ['box', 'aside', 'sidebar'], hint: 'Text beside the main text', run: cmd('insert-text-box') },
+  { id: 'shape-rect', group: 'Shapes', label: 'Rectangle', keys: ['shape', 'box', 'square'], hint: 'Drag on the page to draw it', run: cmd('insert-shape', 'roundRect') },
+  { id: 'shape-circle', group: 'Shapes', label: 'Circle', keys: ['shape', 'oval', 'round'], hint: 'Drag on the page to draw it', run: cmd('insert-shape', 'ellipse') },
+  { id: 'shape-arrow', group: 'Shapes', label: 'Arrow', keys: ['shape', 'right arrow'], hint: 'Drag on the page to draw it', run: cmd('insert-shape', 'rightArrow') },
+  { id: 'shape-callout', group: 'Shapes', label: 'Speech bubble', keys: ['shape', 'callout', 'bubble'], hint: 'Drag on the page to draw it', run: cmd('insert-shape', 'wedgeRoundRectCallout') },
+  { id: 'shape-star', group: 'Shapes', label: 'Star', keys: ['shape'], hint: 'Drag on the page to draw it', run: cmd('insert-shape', 'star5') },
+  { id: 'toc', group: 'References', label: 'Table of contents', keys: ['toc', 'contents', 'index'], hint: 'From your headings', run: cmd('insert-toc') },
+  { id: 'footnote', group: 'References', label: 'Footnote', keys: ['note', 'fn'], hint: 'Note at the bottom of the page', run: cmd('insert-footnote') },
+  { id: 'endnote', group: 'References', label: 'Endnote', keys: ['note'], hint: 'Note at the end', run: cmd('insert-endnote') },
+  { id: 'cite', group: 'References', label: 'Citation', keys: ['cite', 'reference', 'source'], hint: 'Pick a source to cite here', run: cmd('citations-pane') },
+  { id: 'bib', group: 'References', label: 'Bibliography', keys: ['references', 'works cited', 'sources list'], hint: 'Reference list in the current style', run: cmd('insert-bibliography') },
+  { id: 'caption', group: 'References', label: 'Caption', keys: ['figure', 'table caption'], hint: 'Figure or table caption', run: cmd('insert-caption') },
+]
+
+/** score of a command for a query: 0 = no match; prefix matches on the label win */
+export function matchScore(c: Pick<SlashCommand, 'label' | 'keys'>, query: string): number {
+  const q = query.trim().toLowerCase()
+  if (!q) return 1
+  const label = c.label.toLowerCase()
+  const words = [label, ...(c.keys ?? [])].map((w) => w.toLowerCase())
+  if (label.startsWith(q)) return 100 - label.length / 100
+  if (words.some((w) => w === q)) return 90
+  if (words.some((w) => w.startsWith(q))) return 70
+  if (label.split(/\s+/).some((w) => w.startsWith(q))) return 60
+  if (words.some((w) => w.includes(q))) return 30
+  let k = 0
+  for (const ch of label) if (ch === q[k]) k++
+  return k === q.length ? 10 : 0
+}
+
+const matches = (query: string): SlashCommand[] =>
+  query.trim()
+    ? COMMANDS.map((c) => ({ c, s: matchScore(c, query) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s).map((x) => x.c)
+    : COMMANDS
+
+interface Open {
+  /** position of the "/" in the document, or -1 when opened with Ctrl+/ (its own search box) */
+  slashPos: number
+  el: HTMLElement
+  list: SlashCommand[]
+  index: number
+  query: string
+}
+
+function slashPlugins(getEditor: () => Editor | null): Plugin[] {
+  let open: Open | null = null
+
+  const close = (): void => {
+    open?.el.remove()
+    open = null
+    document.removeEventListener('mousedown', outside, true)
+  }
+  function outside(e: MouseEvent): void {
+    if (open && !open.el.contains(e.target as Node)) close()
+  }
+
+  const render = (): void => {
+    if (!open) return
+    const listEl = open.el.querySelector('.kertas-slash-list') as HTMLElement
+    listEl.textContent = ''
+    if (!open.list.length) {
+      const none = document.createElement('div')
+      none.className = 'kertas-slash-none'
+      none.textContent = 'No matching command'
+      listEl.appendChild(none)
+      return
+    }
+    let group = ''
+    open.list.forEach((c, i) => {
+      if (!open!.query.trim() && c.group !== group) {
+        group = c.group
+        const head = document.createElement('div')
+        head.className = 'kertas-slash-group'
+        head.textContent = group
+        listEl.appendChild(head)
+      }
+      const row = document.createElement('button')
+      row.type = 'button'
+      row.className = `kertas-slash-item${i === open!.index ? ' is-active' : ''}`
+      const label = document.createElement('strong')
+      label.textContent = c.label
+      const hint = document.createElement('span')
+      hint.textContent = c.hint
+      row.append(label, hint)
+      row.addEventListener('mousedown', (e) => e.preventDefault())
+      row.addEventListener('click', () => choose(i))
+      row.addEventListener('mousemove', () => {
+        if (open && open.index !== i) { open.index = i; render() }
+      })
+      listEl.appendChild(row)
+      if (i === open!.index) row.scrollIntoView({ block: 'nearest' })
+    })
+  }
+
+  const show = (view: EditorView, slashPos: number): void => {
+    close()
+    const el = document.createElement('div')
+    el.className = 'kertas-slash'
+    if (slashPos < 0) {
+      const input = document.createElement('input')
+      input.type = 'text'
+      input.placeholder = 'Search commands'
+      input.className = 'kertas-slash-search'
+      input.addEventListener('input', () => {
+        if (!open) return
+        open.query = input.value
+        open.list = matches(open.query)
+        open.index = 0
+        render()
+      })
+      input.addEventListener('keydown', (e) => {
+        if (key(e)) { e.preventDefault(); e.stopPropagation() }
+      })
+      el.appendChild(input)
+      setTimeout(() => input.focus())
+    }
+    const list = document.createElement('div')
+    list.className = 'kertas-slash-list'
+    el.appendChild(list)
+    const at = view.coordsAtPos(view.state.selection.from)
+    document.body.appendChild(el)
+    const height = 320
+    const below = at.bottom + 6 + height < window.innerHeight
+    el.style.left = `${Math.max(8, Math.min(at.left, window.innerWidth - 300))}px`
+    if (below) el.style.top = `${at.bottom + 6}px`
+    else el.style.bottom = `${window.innerHeight - at.top + 6}px`
+    open = { slashPos, el, list: matches(''), index: 0, query: '' }
+    render()
+    setTimeout(() => document.addEventListener('mousedown', outside, true))
+  }
+
+  const choose = (i: number): void => {
+    const editor = getEditor()
+    if (!open || !editor) return
+    const command = open.list[i]
+    const { slashPos } = open
+    close()
+    if (!command) return
+    if (slashPos >= 0) {
+      // take the "/" and what was typed after it back out of the text
+      const to = editor.state.selection.from
+      if (to > slashPos && editor.state.doc.textBetween(slashPos, slashPos + 1) === '/') {
+        editor.view.dispatch(editor.state.tr.delete(slashPos, to))
+      }
+    }
+    editor.view.focus()
+    command.run(editor)
+  }
+
+  /** a key while the menu is open; true when it was the menu's */
+  const key = (e: KeyboardEvent): boolean => {
+    if (!open) return false
+    if (e.key === 'Escape') { close(); getEditor()?.view.focus(); return true }
+    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+      const n = open.list.length
+      if (n) open.index = (open.index + (e.key === 'ArrowDown' ? 1 : n - 1)) % n
+      render()
+      return true
+    }
+    if (e.key === 'Enter' || e.key === 'Tab') {
+      if (!open.list.length) { close(); return false }
+      choose(open.index)
+      return true
+    }
+    return false
+  }
+
+  return [
+        new Plugin({
+          view: () => ({
+            update(view) {
+              // the text after the "/" is the search; moving away from it closes the menu
+              if (!open || open.slashPos < 0) return
+              const { selection, doc } = view.state
+              const from = open.slashPos
+              const stillThere = selection.empty && selection.from > from && from < doc.content.size && doc.textBetween(from, from + 1) === '/'
+              const $slash = stillThere ? doc.resolve(from) : null
+              if (!stillThere || !$slash || selection.$from.parent !== $slash.parent) { close(); return }
+              const query = doc.textBetween(from + 1, selection.from)
+              if (/\s{2,}|\n/.test(query) || query.length > 30) { close(); return }
+              if (query !== open.query) {
+                open.query = query
+                open.list = matches(query)
+                open.index = 0
+                // nothing matches and the user keeps typing: it was just a slash in the text
+                if (!open.list.length && query.length > 12) { close(); return }
+                render()
+              }
+            },
+            destroy: close,
+          }),
+          props: {
+            handleKeyDown(view, event) {
+              if ((event.ctrlKey || event.metaKey) && event.key === '/') {
+                if (!view.editable) return false
+                show(view, -1)
+                return true
+              }
+              return key(event)
+            },
+            handleTextInput(view, from, to, text) {
+              if (text !== '/' || from !== to || !view.editable) return false
+              const $from = view.state.doc.resolve(from)
+              if (!$from.parent.isTextblock || $from.parent.type.spec.code) return false
+              const before = $from.parent.textBetween(0, $from.parentOffset, undefined, '￼')
+              // only at the start of a line or after a space: a date or a fraction keeps its slash
+              if (before !== '' && !/\s$/.test(before)) return false
+              // after the "/" is in the text, so the menu sits at the cursor that follows it
+              setTimeout(() => {
+                const now = view.state
+                // fast typing may already be past the slash; what follows it is the search
+                if (
+                  now.selection.empty &&
+                  now.selection.from > from &&
+                  now.selection.from <= from + 30 &&
+                  from < now.doc.content.size &&
+                  now.doc.textBetween(from, from + 1) === '/' &&
+                  !/\s/.test(now.doc.textBetween(from, now.selection.from, '\n'))
+                )
+                  show(view, from)
+              })
+              return false
+            },
+          },
+        }),
+  ]
+}
+
+export const SlashMenuExtension = Extension.create({
+  name: 'kertasSlashMenu',
+
+  addProseMirrorPlugins() {
+    const editor = this.editor
+    return slashPlugins(() => (editor.isDestroyed ? null : editor))
+  },
+})
