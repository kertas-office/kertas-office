+  if (/<w:date\b/.test(sdtPr)) return 'date'
+  if (/<w:text\b/.test(sdtPr)) return 'text'
+  return 'rich'
+}
+
+/** The title a control shows (w:alias), unescaped. */
+export function ctrlFieldTitle(sdtPr: string): string {
+  const m = /<w:alias\b[^>]*\bw:val="([^"]*)"/.exec(sdtPr)
+  return (m?.[1] ?? '')
+    .replace(/&quot;/g, '"')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&amp;/g, '&')
+}
+
