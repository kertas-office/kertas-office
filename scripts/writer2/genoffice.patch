+import { createRequire } from 'node:module'
+import { dirname, join, resolve } from 'node:path'
+import react from '@vitejs/plugin-react'
+import { defineConfig, externalizeDepsPlugin } from 'electron-vite'
+import { normalizePath, type Plugin } from 'vite'
+import { viteStaticCopy } from 'vite-plugin-static-copy'
+import { type AiModules, kertasAssetNames, kertasNoAi as noAiPlugin, kertasNoAiMain, kertasNoAiStrings, kertasQuietBridge, kertasTitle } from '../kertas-build'
+
+// Build used when Kertas Office hosts this editor: the window's bridge and the
+// page. The main-process code is built with the Writer's (apps/docs).
+const require = createRequire(import.meta.url)
+const pdfjsRoot = dirname(dirname(require.resolve('pdfjs-dist/package.json')))
+const pdfjsDir = (sub: string) => normalizePath(join(pdfjsRoot, 'pdfjs-dist', sub))
+
+const noAi = resolve(__dirname, 'src/renderer/kertas/no-ai')
+const AI_MODULES: AiModules = [
+  [/(^|\/)ai\/AiPanel$/, 'AiPanel.tsx'],
+  [/^\.\/AiAskPopover$/, 'AiAskPopover.tsx'],
+]
+const kertasNoAi = (): Plugin => noAiPlugin(noAi, AI_MODULES)
+
+export default defineConfig({
+  preload: {
+    plugins: [kertasNoAi(), kertasNoAiMain(), kertasQuietBridge(), externalizeDepsPlugin({ exclude: ['@genoffice/i18n', '@genoffice/electron-utils'] })],
+    build: { outDir: 'out-kertas/preload' },
+  },
+  renderer: {
+    plugins: [
+      kertasNoAi(),
+      kertasNoAiMain(),
+      kertasNoAiStrings(),
+      kertasTitle('PDF'),
+      react(),
+      viteStaticCopy({
+        targets: [
+          { src: pdfjsDir('cmaps'), dest: 'pdfjs' },
+          { src: pdfjsDir('standard_fonts'), dest: 'pdfjs' },
+          { src: pdfjsDir('wasm'), dest: 'pdfjs' },
+        ],
+      }),
+    ],
+    build: {
+      outDir: 'out-kertas/renderer',
+      rollupOptions: { output: { assetFileNames: kertasAssetNames } },
+    },
+  },
+})
diff --git a/apps/pdf/src/main/kertas-pdf.ts b/apps/pdf/src/main/kertas-pdf.ts
new file mode 100644
index 0000000..20c43de
--- /dev/null
+++ b/apps/pdf/src/main/kertas-pdf.ts
@@ -0,0 +1,308 @@
+// Kertas Office's additions to the PDF editor's main process: duplicating a page,
+// flattening a form, and saving which layers a file opens with. Each works on the file on
+// disk (the editor saves pending edits first) and the editor reloads it afterwards.
+import { readFile } from 'node:fs/promises'
+import { BrowserWindow, dialog, ipcMain } from 'electron'
+import { PDFArray, PDFDict, PDFDocument, PDFHexString, PDFName, PDFNumber, PDFRef, PDFString } from 'pdf-lib'
+import { writePdfAtomically } from './atomic-write'
+
+/** Text recognition supplied by Kertas Office (its own engine, which reads many languages on
+ *  every system); the editor's system helpers are used only when it is not set. */
+type KertasOcr = (pngBase64: string, langs: string[]) => Promise<unknown[] | null>
+let ocrLangs: string[] = ['eng']
+export const kertasOcrLangs = (): string[] => ocrLangs
+let kertasOcr: KertasOcr | null = null
+export function setKertasOcr(fn: KertasOcr | null): void {
+  kertasOcr = fn
+}
+export const kertasOcrEngine = (): KertasOcr | null => kertasOcr
+
+export const KERTAS_PDF_CHANNELS = {
+  duplicatePage: 'pdf:kertas-duplicate-page',
+  flatten: 'pdf:kertas-flatten',
+  layerDefaults: 'pdf:kertas-layer-defaults',
+} as const
+
+type Result = { ok: true } | { ok: true; canceled: true } | { ok: false; error: string }
+const failed = (err: unknown): Result => ({ ok: false, error: err instanceof Error ? err.message : String(err) })
+
+/** pdf.js names a layer by its object reference: "12R", or "12R3" for generation 3 */
+function refOf(id: string): PDFRef | null {
+  const m = /^(\d+)R(\d*)$/.exec(id)
+  return m ? PDFRef.of(Number(m[1]), m[2] ? Number(m[2]) : 0) : null
+}
+
+export function registerKertasPdfIpc(granted: (wcId: number, path: string) => boolean): void {
+  registerKertasObjectIpc(granted)
+  ipcMain.handle('pdf:kertas-ocr-langs', (_e, langs: unknown) => {
+    if (Array.isArray(langs) && langs.length && langs.every((l) => typeof l === 'string' && /^[a-z_]{2,10}$/.test(l))) ocrLangs = langs.slice(0, 8)
+  })
+
+  const load = async (path: string) => PDFDocument.load(new Uint8Array(await readFile(path)), { updateMetadata: false })
+
+  ipcMain.handle(KERTAS_PDF_CHANNELS.duplicatePage, async (e, req: unknown): Promise<Result> => {
+    const { path, pageIndex } = (req ?? {}) as { path?: unknown; pageIndex?: unknown }
+    if (typeof path !== 'string' || !granted(e.sender.id, path)) return { ok: false, error: 'pdf: path not granted to this view' }
+    try {
+      const doc = await load(path)
+      const at = typeof pageIndex === 'number' ? Math.trunc(pageIndex) : -1
+      if (at < 0 || at >= doc.getPageCount()) return { ok: false, error: 'There is no such page' }
+      const [copy] = await doc.copyPages(doc, [at])
+      doc.insertPage(at + 1, copy!)
+      await writePdfAtomically(path, await doc.save({ useObjectStreams: true }))
+      return { ok: true }
+    } catch (err) {
+      return failed(err)
+    }
+  })
+
+  ipcMain.handle(KERTAS_PDF_CHANNELS.flatten, async (e, req: unknown): Promise<Result> => {
+    const { path } = (req ?? {}) as { path?: unknown }
+    if (typeof path !== 'string' || !granted(e.sender.id, path)) return { ok: false, error: 'pdf: path not granted to this view' }
+    try {
+      const doc = await load(path)
+      const form = doc.getForm()
+      if (form.getFields().length === 0) return { ok: false, error: 'This PDF has no form fields to flatten' }
+      const win = BrowserWindow.fromWebContents(e.sender) ?? undefined
+      const opts = {
+        type: 'question' as const,
+        buttons: ['Flatten', 'Cancel'],
+        defaultId: 0,
+        cancelId: 1,
+        message: 'Flatten the form?',
+        detail: 'The filled-in values become part of the page and can no longer be changed, and the fields are removed. This is saved to the file.',
+      }
+      const { response } = win ? await dialog.showMessageBox(win, opts) : await dialog.showMessageBox(opts)
+      if (response !== 0) return { ok: true, canceled: true }
+      form.flatten({ updateFieldAppearances: true })
+      await writePdfAtomically(path, await doc.save({ useObjectStreams: true }))
+      return { ok: true }
+    } catch (err) {
+      return failed(err)
+    }
+  })
+
+  ipcMain.handle(KERTAS_PDF_CHANNELS.layerDefaults, async (e, req: unknown): Promise<Result> => {
+    const { path, hidden } = (req ?? {}) as { path?: unknown; hidden?: unknown }
+    if (typeof path !== 'string' || !granted(e.sender.id, path)) return { ok: false, error: 'pdf: path not granted to this view' }
+    if (!Array.isArray(hidden)) return { ok: false, error: 'pdf: bad request' }
+    try {
+      const doc = await load(path)
+      const props = doc.catalog.lookupMaybe(PDFName.of('OCProperties'), PDFDict)
+      const all = props?.lookupMaybe(PDFName.of('OCGs'), PDFArray)
+      if (!props || !all) return { ok: false, error: 'This PDF has no layers' }
+      const off = new Set(hidden.map((id) => refOf(String(id))?.toString()).filter(Boolean))
+      const on: PDFRef[] = []
+      const offRefs: PDFRef[] = []
+      for (let i = 0; i < all.size(); i++) {
+        const ref = all.get(i)
+        if (!(ref instanceof PDFRef)) continue
+        ;(off.has(ref.toString()) ? offRefs : on).push(ref)
+      }
+      let d = props.lookupMaybe(PDFName.of('D'), PDFDict)
+      if (!d) {
+        d = doc.context.obj({})
+        props.set(PDFName.of('D'), d)
+      }
+      d.set(PDFName.of('BaseState'), PDFName.of('ON'))
+      d.set(PDFName.of('ON'), doc.context.obj(on))
+      d.set(PDFName.of('OFF'), doc.context.obj(offRefs))
+      await writePdfAtomically(path, await doc.save({ useObjectStreams: true }))
+      return { ok: true }
+    } catch (err) {
+      return failed(err)
+    }
+  })
+}
+
+// ---- page items: the annotations on a page (shapes, drawings, stamps, notes, text boxes) ----
+// Moved, resized, put in front of or behind each other, deleted, and put on a layer. Each change
+// is written to the file at once, and the editor reloads it (so Undo works as for page edits).
+
+type Rect = [number, number, number, number]
+export type KertasObjectOp =
+  | { type: 'move'; id: string; rect: Rect; to: Rect }
+  | { type: 'order'; id: string; rect: Rect; where: 'front' | 'back' }
+  | { type: 'delete'; id: string; rect: Rect }
+  | { type: 'layer'; id: string; rect: Rect; layer: string | null }
+  | { type: 'newLayer'; id: string | null; rect: Rect | null; name: string }
+  | { type: 'stamp'; rect: Rect; png: string; label: string; author: string }
+
+const refId = (ref: PDFRef): string => `${ref.objectNumber}R${ref.generationNumber ? ref.generationNumber : ''}`
+const num = (v: unknown): number => (v instanceof PDFNumber ? v.asNumber() : NaN)
+const rectOf = (dict: PDFDict): Rect | null => {
+  const r = dict.lookupMaybe(PDFName.of('Rect'), PDFArray)
+  if (!r || r.size() < 4) return null
+  const [a, b, c, d] = [0, 1, 2, 3].map((i) => num(r.lookup(i)))
+  return [Math.min(a!, c!), Math.min(b!, d!), Math.max(a!, c!), Math.max(b!, d!)]
+}
+
+/** The annotation on this page by its reference, or by its box when the file was renumbered */
+function findAnnot(doc: PDFDocument, pageIndex: number, id: string, rect: Rect | null) {
+  const page = doc.getPage(pageIndex)
+  const annots = page.node.lookupMaybe(PDFName.of('Annots'), PDFArray)
+  if (!annots) return null
+  let byRect: { index: number; ref: PDFRef; dict: PDFDict } | null = null
+  for (let i = 0; i < annots.size(); i++) {
+    const ref = annots.get(i)
+    if (!(ref instanceof PDFRef)) continue
+    const dict = doc.context.lookup(ref)
+    if (!(dict instanceof PDFDict)) continue
+    if (refId(ref) === id) return { annots, index: i, ref, dict }
+    const r = rectOf(dict)
+    if (rect && r && !byRect && r.every((v, k) => Math.abs(v - rect[k]!) < 0.5)) byRect = { index: i, ref, dict }
+  }
+  return byRect ? { annots, ...byRect } : null
+}
+
+/** Every point of the annotation's shape, through x' = ax + b, y' = cy + d */
+function mapAnnotPoints(dict: PDFDict, f: (x: number, y: number) => [number, number]): void {
+  const mapFlat = (arr: PDFArray): void => {
+    for (let i = 0; i + 1 < arr.size(); i += 2) {
+      const [x, y] = f(num(arr.lookup(i)), num(arr.lookup(i + 1)))
+      arr.set(i, PDFNumber.of(x))
+      arr.set(i + 1, PDFNumber.of(y))
+    }
+  }
+  for (const key of ['QuadPoints', 'L', 'Vertices', 'CL']) {
+    const arr = dict.lookupMaybe(PDFName.of(key), PDFArray)
+    if (arr) mapFlat(arr)
+  }
+  const ink = dict.lookupMaybe(PDFName.of('InkList'), PDFArray)
+  if (ink) for (let i = 0; i < ink.size(); i++) {
+    const path = ink.lookup(i)
+    if (path instanceof PDFArray) mapFlat(path)
+  }
+}
+
+function layerProps(doc: PDFDocument): PDFDict {
+  let props = doc.catalog.lookupMaybe(PDFName.of('OCProperties'), PDFDict)
+  if (!props) {
+    props = doc.context.obj({ OCGs: [], D: { Order: [], ON: [], OFF: [] } }) as PDFDict
+    doc.catalog.set(PDFName.of('OCProperties'), props)
+  }
+  if (!props.lookupMaybe(PDFName.of('OCGs'), PDFArray)) props.set(PDFName.of('OCGs'), doc.context.obj([]))
+  let d = props.lookupMaybe(PDFName.of('D'), PDFDict)
+  if (!d) {
+    d = doc.context.obj({}) as PDFDict
+    props.set(PDFName.of('D'), d)
+  }
+  return props
+}
+
+export async function applyObjectOp(bytes: Uint8Array, pageIndex: number, op: KertasObjectOp): Promise<{ bytes: Uint8Array; layer?: string }> {
+  const doc = await PDFDocument.load(bytes, { updateMetadata: false })
+  if (pageIndex < 0 || pageIndex >= doc.getPageCount()) throw new Error('There is no such page')
+  let layer: string | undefined
+  if (op.type === 'stamp') {
+    const [x1, y1, x2, y2] = op.rect
+    const w = x2 - x1
+    const h = y2 - y1
+    const img = await doc.embedPng(Buffer.from(op.png, 'base64'))
+    const ap = doc.context.register(
+      doc.context.stream(`q ${w} 0 0 ${h} 0 0 cm /Im0 Do Q`, {
+        Type: 'XObject',
+        Subtype: 'Form',
+        BBox: [0, 0, w, h],
+        Resources: { XObject: { Im0: img.ref } },
+      }),
+    )
+    const annot = doc.context.register(
+      doc.context.obj({
+        Type: 'Annot',
+        Subtype: 'Stamp',
+        Rect: [x1, y1, x2, y2],
+        F: 4,
+        Name: op.label.replace(/[^A-Za-z]/g, '') || 'Stamp',
+        Contents: PDFHexString.fromText(op.label),
+        ...(op.author ? { T: PDFHexString.fromText(op.author) } : {}),
+        M: PDFString.fromDate(new Date()),
+        AP: { N: ap },
+      }),
+    )
+    doc.getPage(pageIndex).node.addAnnot(annot)
+  } else if (op.type === 'newLayer') {
+    const props = layerProps(doc)
+    const ocg = doc.context.register(doc.context.obj({ Type: 'OCG', Name: PDFHexString.fromText(op.name.trim() || 'New layer') }))
+    props.lookup(PDFName.of('OCGs'), PDFArray).push(ocg)
+    const d = props.lookup(PDFName.of('D'), PDFDict)
+    for (const key of ['Order', 'ON']) {
+      let arr = d.lookupMaybe(PDFName.of(key), PDFArray)
+      if (!arr) {
+        arr = doc.context.obj([]) as PDFArray
+        d.set(PDFName.of(key), arr)
+      }
+      arr.push(ocg)
+    }
+    layer = refId(ocg)
+    if (op.id && op.rect) {
+      const found = findAnnot(doc, pageIndex, op.id, op.rect)
+      if (!found) throw new Error('That item is no longer on the page')
+      found.dict.set(PDFName.of('OC'), ocg)
+    }
+  } else {
+    const found = findAnnot(doc, pageIndex, op.id, op.rect)
+    if (!found) throw new Error('That item is no longer on the page')
+    const { annots, index, ref, dict } = found
+    if (op.type === 'move') {
+      const [a1, b1, a2, b2] = op.rect
+      const [c1, d1, c2, d2] = op.to
+      const sx = a2 - a1 > 0.01 ? (c2 - c1) / (a2 - a1) : 1
+      const sy = b2 - b1 > 0.01 ? (d2 - d1) / (b2 - b1) : 1
+      const f = (x: number, y: number): [number, number] => [c1 + (x - a1) * sx, d1 + (y - b1) * sy]
+      dict.set(PDFName.of('Rect'), doc.context.obj([c1, d1, c2, d2]))
+      mapAnnotPoints(dict, f)
+      // a comment's pop-up travels with it
+      const popup = dict.lookupMaybe(PDFName.of('Popup'), PDFDict)
+      const pr = popup && rectOf(popup)
+      if (popup && pr) popup.set(PDFName.of('Rect'), doc.context.obj([pr[0] + c1 - a1, pr[1] + d1 - b1, pr[2] + c1 - a1, pr[3] + d1 - b1]))
+    } else if (op.type === 'order') {
+      annots.remove(index)
+      if (op.where === 'front') annots.push(ref)
+      else annots.insert(0, ref)
+    } else if (op.type === 'delete') {
+      annots.remove(index)
+      const popup = dict.get(PDFName.of('Popup'))
+      if (popup instanceof PDFRef) for (let i = annots.size() - 1; i >= 0; i--) {
+        const r = annots.get(i)
+        if (r instanceof PDFRef && r.objectNumber === popup.objectNumber) annots.remove(i)
+      }
+    } else if (op.type === 'layer') {
+      if (op.layer === null) dict.delete(PDFName.of('OC'))
+      else {
+        const target = /^(\d+)R(\d*)$/.exec(op.layer)
+        if (!target) throw new Error('No such layer')
+        dict.set(PDFName.of('OC'), PDFRef.of(Number(target[1]), target[2] ? Number(target[2]) : 0))
+      }
+    }
+  }
+  return { bytes: await doc.save({ useObjectStreams: true }), ...(layer ? { layer } : {}) }
+}
+
+export function registerKertasObjectIpc(granted: (wcId: number, path: string) => boolean): void {
+  ipcMain.handle('pdf:kertas-annot-layer', async (e, req: unknown): Promise<string | null> => {
+    const { path, pageIndex, id, rect } = (req ?? {}) as { path?: unknown; pageIndex?: unknown; id?: unknown; rect?: unknown }
+    if (typeof path !== 'string' || !granted(e.sender.id, path) || typeof pageIndex !== 'number' || typeof id !== 'string') return null
+    try {
+      const doc = await PDFDocument.load(new Uint8Array(await readFile(path)), { updateMetadata: false })
+      const found = findAnnot(doc, pageIndex, id, Array.isArray(rect) ? (rect as Rect) : null)
+      const oc = found?.dict.get(PDFName.of('OC'))
+      return oc instanceof PDFRef ? refId(oc) : null
+    } catch {
+      return null
+    }
+  })
+
+  ipcMain.handle('pdf:kertas-object-op', async (e, req: unknown): Promise<Result & { layer?: string }> => {
+    const { path, pageIndex, op } = (req ?? {}) as { path?: unknown; pageIndex?: unknown; op?: KertasObjectOp }
+    if (typeof path !== 'string' || !granted(e.sender.id, path)) return { ok: false, error: 'pdf: path not granted to this view' }
+    if (typeof pageIndex !== 'number' || !op || typeof op !== 'object') return { ok: false, error: 'pdf: bad request' }
+    try {
+      const out = await applyObjectOp(new Uint8Array(await readFile(path)), Math.trunc(pageIndex), op)
+      await writePdfAtomically(path, out.bytes)
+      return { ok: true, ...(out.layer ? { layer: out.layer } : {}) }
+    } catch (err) {
+      return failed(err)
+    }
+  })
+}
diff --git a/apps/pdf/src/main/pdf-main.ts b/apps/pdf/src/main/pdf-main.ts
index e8c72ad..f8e62c1 100644
--- a/apps/pdf/src/main/pdf-main.ts
+++ b/apps/pdf/src/main/pdf-main.ts
@@ -97,6 +97,7 @@ import type {
   SignaturePosition,
