+
+// Build used when Kertas Office hosts this editor: the window's bridge and the
+// page. The main-process code is built with the Writer's (apps/docs), so the
+// three editors share one bundle there.
+const noAi = resolve(__dirname, 'src/renderer/kertas/no-ai')
+const AI_MODULES: AiModules = [
+  [/(^|\/)ai\/AiChatPanel$/, 'AiChatPanel.tsx'],
