+++ b/apps/kertas-file-button.tsx
@@ -0,0 +1,99 @@
+// The File button at the start of the tab row, as in Kertas's own Sheets and PDF editors:
+// a pill in the app's colour, opening the same file menu as Kertas's (new, open, save,
+// export, print, close). Each item is carried out by Kertas, so it behaves as everywhere else.
+import { useEffect, useRef, useState, type ReactElement } from 'react'
+
+export interface FileMenuItem {
+  id: string
+  label: string
+  key?: string
+  icon: string
+}
+
+const ICONS: Record<string, string> = {
+  doc: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h6',
+  sheet: 'M4 4h16v16H4zM4 10h16M4 15h16M10 4v16',
+  open: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v1H7.5a2 2 0 0 0-1.9 1.4L3 19zM3 19l2.6-7.6A2 2 0 0 1 7.5 10H21l-2.7 8.1A2 2 0 0 1 16.4 19z',
+  save: 'M5 3h11l3 3v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM7 3v5h8V3M7 21v-7h10v7',
+  saveAs: 'M5 3h11l3 3v5M7 3v5h8V3M7 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2M13 21l1-3 5-5 2 2-5 5z',
+  export: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M12 18v-6M9 15l3 3 3-3',
+  csv: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M8 13h8M8 17h8M12 11v8',
+  print: 'M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z',
+  close: 'M6 6l12 12M18 6L6 18',
+}
+
+export function KertasFileButton({
+  items,
+  onPick,
+}: {
+  /** null is a separator */
+  items: Array<FileMenuItem | null>
+  onPick: (id: string) => void
+}): ReactElement {
+  const [open, setOpen] = useState(false)
+  const wrap = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    if (!open) return
+    const away = (e: PointerEvent): void => {
+      if (!wrap.current?.contains(e.target as Node)) setOpen(false)
+    }
+    const key = (e: KeyboardEvent): void => {
+      if (e.key === 'Escape') setOpen(false)
+    }
+    window.addEventListener('pointerdown', away, true)
+    window.addEventListener('keydown', key)
+    return () => {
+      window.removeEventListener('pointerdown', away, true)
+      window.removeEventListener('keydown', key)
+    }
+  }, [open])
+  return (
+    <div className="kertas-file-wrap" ref={wrap}>
+      <button type="button" className={`kertas-file-tab${open ? ' open' : ''}`} onClick={() => setOpen((v) => !v)}>
+        File
+      </button>
+      {open && (
+        <div className="kertas-file-menu" role="menu">
+          {items.map((it, i) =>
+            it ? (
+              <button
+                key={it.id}
+                type="button"
+                role="menuitem"
+                onClick={() => {
+                  setOpen(false)
+                  onPick(it.id)
+                }}
+              >
+                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+                  <path d={ICONS[it.icon] ?? ''} />
+                </svg>
+                <span>{it.label}</span>
+                {it.key && <kbd>{it.key}</kbd>}
+              </button>
+            ) : (
+              <div key={`sep-${i}`} className="kertas-file-sep" />
+            ),
+          )}
+        </div>
+      )}
+    </div>
+  )
+}
+
+/** The items every Kertas editor's File menu has, around the editor's own (`extra`) */
+export function fileMenuItems(extra: FileMenuItem[] = [], { exportPdf = true } = {}): Array<FileMenuItem | null> {
+  return [
+    { id: 'new-doc', label: 'New document', key: 'Ctrl+N', icon: 'doc' },
+    { id: 'new-sheet', label: 'New spreadsheet', key: 'Ctrl+Shift+N', icon: 'sheet' },
+    { id: 'open', label: 'Open...', key: 'Ctrl+O', icon: 'open' },
+    null,
+    { id: 'save', label: 'Save', key: 'Ctrl+S', icon: 'save' },
+    { id: 'save-as', label: 'Save as...', key: 'Ctrl+Shift+S', icon: 'saveAs' },
+    ...(exportPdf ? [{ id: 'export-pdf', label: 'Export as PDF...', key: 'Ctrl+Shift+E', icon: 'export' }] : []),
+    ...extra,
+    { id: 'print', label: 'Print...', key: 'Ctrl+P', icon: 'print' },
+    null,
+    { id: 'close-tab', label: 'Close tab', key: 'Ctrl+W', icon: 'close' },
+  ]
+}
