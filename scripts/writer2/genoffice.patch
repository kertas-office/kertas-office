+// Kertas Office: the Form fields group on the Insert tab.
+import type { Editor } from '@tiptap/core'
+import { currentField, editFieldProperties, insertFormField, type FormFieldKind } from './form-fields'
+
+const ICONS: Record<FormFieldKind | 'props', string> = {
+  text: 'M3 5h10M8 5v7M5.5 12h5',
+  checkbox: 'M3 3h10v10H3zM5.5 8l2 2 3.5-4',
+  list: 'M2.5 4.5h11v7h-11zM9.5 7l1.5 1.8L12.5 7',
+  date: 'M3 4h10v9H3zM3 7h10M6 2.5v3M10 2.5v3',
+  props: 'M3 4.5h10M3 8h10M3 11.5h10M6 3.2v2.6M10 6.7v2.6M7 10.2v2.6',
+}
+
+function Icon({ d }: { d: string }) {
+  return (
+    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
+      <path d={d} />
+    </svg>
+  )
+}
+
+export function FormFieldsGroup({ editor, disabled }: { editor: Editor; disabled: boolean }) {
+  const inField = !disabled && !!currentField(editor)
+  const button = (kind: FormFieldKind, label: string, tip: string) => (
+    // command-exempt: Kertas's own group, kept apart from the shared command table
+    <button className="rb-small" disabled={disabled} data-tip={tip} onClick={() => void insertFormField(editor, kind)}>
+      <Icon d={ICONS[kind]} />
+      <span className="rb-small-label">{label}</span>
+    </button>
+  )
+  return (
+    <>
+      <div className="ribbon-group">
+        <div className="ribbon-group-items">
+          <div className="rb-col" data-wide="1">
+            {button('text', 'Text field', 'Text field: a box to type in')}
+            {button('checkbox', 'Tick box', 'Tick box: click to tick or clear')}
+            {button('list', 'Dropdown list', 'Dropdown list: pick one of your choices')}
+          </div>
+          <div className="rb-col" data-wide="1">
+            {button('date', 'Date picker', 'Date picker: pick a date from a calendar')}
+            {/* command-exempt: Kertas's own group */}
+            <button className="rb-small" disabled={!inField} data-tip="Field properties: change the title, choices or date format of the field the cursor is in" onClick={() => void editFieldProperties(editor)}>
+              <Icon d={ICONS.props} />
+              <span className="rb-small-label">Field properties</span>
+            </button>
+          </div>
+        </div>
+        <div className="ribbon-group-label">Form fields</div>
+      </div>
+      <div className="ribbon-sep" />
+    </>
+  )
+}
diff --git a/apps/docs/src/renderer/kertas/form-fields.ts b/apps/docs/src/renderer/kertas/form-fields.ts
