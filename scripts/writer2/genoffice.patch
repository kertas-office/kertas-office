diff --git a/apps/pdf/src/renderer/kertas/LayersPanel.tsx b/apps/pdf/src/renderer/kertas/LayersPanel.tsx
new file mode 100644
index 0000000..e0e8140
--- /dev/null
+++ b/apps/pdf/src/renderer/kertas/LayersPanel.tsx
@@ -0,0 +1,51 @@
+// Layers panel: the PDF's layers, each shown or hidden with a tick, and a way to keep the
+// current choice as how the file opens in every reader.
+import { useEffect, useState, type ReactElement } from 'react'
+import type { PDFDocumentProxy } from 'pdfjs-dist'
+import { listLayers, setLayerVisible, useLayerRev, type LayerRow } from './layers'
+
+export function LayersPanel({
+  doc,
+  readOnly,
+  onKeep,
+}: {
+  doc: PDFDocumentProxy | null
+  readOnly: boolean
+  onKeep: (hidden: string[]) => void
+}): ReactElement {
+  const rev = useLayerRev()
+  const [rows, setRows] = useState<LayerRow[] | null>(null)
+  useEffect(() => {
+    let stale = false
+    if (!doc) return
+    void listLayers(doc).then((r) => {
+      if (!stale) setRows(r)
+    })
+    return () => {
+      stale = true
+    }
+  }, [doc, rev])
+  if (!doc || rows === null) return <div className="kertas-layers-empty">Loading layers</div>
+  if (rows.length === 0) {
+    return <div className="kertas-layers-empty">This PDF has no layers. Layers keep parts of a page apart, so they can be shown or hidden on their own (plans, drawings, translations).</div>
+  }
+  return (
+    <div className="kertas-layers">
+      {rows.map((r) => (
+        <label key={r.id} className="kertas-layer-row">
+          <input type="checkbox" checked={r.visible} onChange={(e) => void setLayerVisible(doc, r.id, e.target.checked)} />
+          <span>{r.name}</span>
+        </label>
+      ))}
+      <button
+        type="button"
+        className="pdf-modal-btn kertas-layers-keep"
+        disabled={readOnly}
+        title="Saves which layers are shown into the file, so it opens this way in every reader"
+        onClick={() => onKeep(rows.filter((r) => !r.visible).map((r) => r.id))}
+      >
+        Open the file like this
+      </button>
+    </div>
+  )
+}
diff --git a/apps/pdf/src/renderer/kertas/ObjectLayer.tsx b/apps/pdf/src/renderer/kertas/ObjectLayer.tsx
new file mode 100644
index 0000000..92e309e
--- /dev/null
+++ b/apps/pdf/src/renderer/kertas/ObjectLayer.tsx
@@ -0,0 +1,256 @@
+// Select mode (Kertas Office): the items on a page (shapes, drawings, stamps, comments, text
+// boxes) can be picked, dragged to move, resized from a corner, put in front of or behind each
+// other, put on a layer, or deleted. Every change goes to the file through the host and the
+// page reloads, so Undo takes it back like any page edit.
+import { useEffect, useRef, useState, type ReactElement, type PointerEvent as RPointerEvent } from 'react'
+import type { PDFDocumentProxy } from 'pdfjs-dist'
+import { pdfRectToCss, viewToPdf, type PageGeom } from '../annotations'
+import { listLayers, type LayerRow } from './layers'
+
+type Rect = [number, number, number, number]
+export type ObjectOp =
+  | { type: 'move'; id: string; rect: Rect; to: Rect }
+  | { type: 'order'; id: string; rect: Rect; where: 'front' | 'back' }
+  | { type: 'delete'; id: string; rect: Rect }
+  | { type: 'layer'; id: string; rect: Rect; layer: string | null }
+  | { type: 'newLayer'; id: string; rect: Rect; name: string }
+
+interface Item {
+  id: string
+  subtype: string
+  rect: Rect
+  layer: string | null
+}
+
+const KINDS: Record<string, string> = {
+  Square: 'Rectangle',
+  Circle: 'Ellipse',
+  Line: 'Line',
+  Ink: 'Drawing',
+  Polygon: 'Polygon',
+  PolyLine: 'Line',
+  FreeText: 'Text box',
+  Stamp: 'Stamp',
+  Text: 'Comment',
+  FileAttachment: 'Attachment',
+  Caret: 'Caret',
+}
+
+const cache = new WeakMap<PDFDocumentProxy, Map<number, Promise<Item[]>>>()
+function itemsOf(doc: PDFDocumentProxy, pageNo: number): Promise<Item[]> {
+  let byPage = cache.get(doc)
+  if (!byPage) cache.set(doc, (byPage = new Map()))
+  let p = byPage.get(pageNo)
+  if (!p) {
+    p = doc.getPage(pageNo).then(async (page) => {
+      const annots = (await page.getAnnotations({ intent: 'display' })) as Array<{
+        id?: string
+        subtype?: string
+        rect?: number[]
+      }>
+      return annots
+        .filter((a) => a.id && a.subtype && KINDS[a.subtype] && a.rect?.length === 4)
+        .map((a) => {
+          const [x1, y1, x2, y2] = a.rect as Rect
+          return {
+            id: a.id!,
+            subtype: a.subtype!,
+            rect: [Math.min(x1, x2), Math.min(y1, y2), Math.max(x1, x2), Math.max(y1, y2)] as Rect,
+            layer: null,
+          }
+        })
+    })
+    byPage.set(pageNo, p)
+  }
+  return p
+}
+
+type Drag = { mode: 'move' | 'resize'; corner?: number; x: number; y: number; dx: number; dy: number }
+
+export function ObjectLayer({
+  doc,
+  pageNo,
+  geom,
+  scale,
+  readOnly,
+  onApply,
+  layerOf,
+}: {
+  doc: PDFDocumentProxy
+  pageNo: number
+  geom: PageGeom
+  scale: number
+  readOnly: boolean
+  onApply: (op: ObjectOp) => void
+  /** the layer the item is on, read from the file */
+  layerOf: (id: string, rect: Rect) => Promise<string | null>
+}): ReactElement {
+  const [items, setItems] = useState<Item[]>([])
+  const [sel, setSel] = useState<string | null>(null)
+  const [drag, setDrag] = useState<Drag | null>(null)
+  const [layers, setLayers] = useState<LayerRow[] | null>(null)
+  const [naming, setNaming] = useState(false)
+  const [name, setName] = useState('')
+  const rootRef = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    let stale = false
+    void itemsOf(doc, pageNo).then((r) => {
+      if (!stale) setItems(r)
+    })
+    return () => {
+      stale = true
+    }
+  }, [doc, pageNo])
+  useEffect(() => {
+    setLayers(null)
+    setNaming(false)
+  }, [sel])
+  useEffect(() => {
+    if (!sel) return
+    const key = (e: KeyboardEvent): void => {
+      const it = items.find((i) => i.id === sel)
+      if (!it || readOnly) return
+      const target = e.target as HTMLElement
+      if (target.closest('input, textarea')) return
+      if (e.key === 'Delete' || e.key === 'Backspace') {
+        e.preventDefault()
+        onApply({ type: 'delete', id: it.id, rect: it.rect })
+      } else if (e.key === 'Escape') setSel(null)
+    }
+    window.addEventListener('keydown', key)
+    return () => window.removeEventListener('keydown', key)
+  }, [sel, items, readOnly, onApply])
+
+  // a change seen on screen (css px) as the item's new box in PDF space
+  const moved = (it: Item, d: Drag): Rect => {
+    const box = pdfRectToCss(geom, it.rect, scale)
+    let { left, top, width, height } = box
+    if (d.mode === 'move') {
+      left += d.dx
+      top += d.dy
+    } else {
+      const c = d.corner ?? 2 // 0 top-left, 1 top-right, 2 bottom-right, 3 bottom-left
+      if (c === 0 || c === 3) { left += d.dx; width -= d.dx } else width += d.dx
+      if (c === 0 || c === 1) { top += d.dy; height -= d.dy } else height += d.dy
+      width = Math.max(width, 6)
+      height = Math.max(height, 6)
+    }
+    const [ax, ay] = viewToPdf(geom, left / scale, top / scale)
+    const [bx, by] = viewToPdf(geom, (left + width) / scale, (top + height) / scale)
+    return [Math.min(ax, bx), Math.min(ay, by), Math.max(ax, bx), Math.max(ay, by)]
+  }
+
+  const start = (e: RPointerEvent, it: Item, mode: Drag['mode'], corner?: number): void => {
+    e.preventDefault()
+    e.stopPropagation()
+    setSel(it.id)
+    if (readOnly) return
+    ;(e.target as HTMLElement).setPointerCapture(e.pointerId)
+    setDrag({ mode, ...(corner !== undefined ? { corner } : {}), x: e.clientX, y: e.clientY, dx: 0, dy: 0 })
+  }
+  const moveDrag = (e: RPointerEvent): void => {
+    if (drag) setDrag({ ...drag, dx: e.clientX - drag.x, dy: e.clientY - drag.y })
+  }
+  const endDrag = (it: Item): void => {
+    const d = drag
+    setDrag(null)
+    if (!d || (Math.abs(d.dx) < 2 && Math.abs(d.dy) < 2)) return
+    onApply({ type: 'move', id: it.id, rect: it.rect, to: moved(it, d) })
+  }
+
+  const selected = items.find((i) => i.id === sel) ?? null
+  return (
+    <div
+      ref={rootRef}
+      className="kertas-objects"
+      onPointerDown={(e) => {
+        if (e.target === rootRef.current) setSel(null)
+      }}
+    >
+      {items.map((it) => {
+        const live = drag && sel === it.id ? pdfRectToCss(geom, moved(it, drag), scale) : pdfRectToCss(geom, it.rect, scale)
+        const on = sel === it.id
+        return (
+          <div
+            key={it.id}
+            className={`kertas-object${on ? ' is-selected' : ''}`}
+            style={live}
+            title={KINDS[it.subtype]}
+            onPointerDown={(e) => start(e, it, 'move')}
+            onPointerMove={moveDrag}
+            onPointerUp={() => endDrag(it)}
+          >
+            {on && !readOnly &&
+              [0, 1, 2, 3].map((c) => (
+                <span
+                  key={c}
+                  className={`kertas-object-grip g${c}`}
+                  onPointerDown={(e) => start(e, it, 'resize', c)}
+                  onPointerMove={moveDrag}
+                  onPointerUp={() => endDrag(it)}
+                />
+              ))}
+          </div>
+        )
+      })}
+      {selected && !drag && !readOnly && (() => {
+        const box = pdfRectToCss(geom, selected.rect, scale)
+        return (
+          <div className="kertas-object-menu" style={{ left: box.left, top: box.top + box.height + 8 }} onPointerDown={(e) => e.stopPropagation()}>
+            <span className="kertas-object-kind">{KINDS[selected.subtype]}</span>
+            <button type="button" title="Bring to front" onClick={() => onApply({ type: 'order', id: selected.id, rect: selected.rect, where: 'front' })}>
+              Bring to front
+            </button>
+            <button type="button" title="Send to back" onClick={() => onApply({ type: 'order', id: selected.id, rect: selected.rect, where: 'back' })}>
+              Send to back
+            </button>
+            <button
+              type="button"
+              onClick={() =>
+                void Promise.all([listLayers(doc), layerOf(selected.id, selected.rect)]).then(([rows, on]) => {
+                  selected.layer = on
+                  setLayers(rows)
+                })
+              }
+            >
+              Layer
+            </button>
+            <button type="button" className="is-danger" onClick={() => onApply({ type: 'delete', id: selected.id, rect: selected.rect })}>
+              Delete
+            </button>
+            {layers && (
+              <div className="kertas-object-layers">
+                <label className="kertas-layer-row">
+                  <input type="radio" checked={selected.layer === null} onChange={() => onApply({ type: 'layer', id: selected.id, rect: selected.rect, layer: null })} />
+                  <span>No layer</span>
+                </label>
+                {layers.map((l) => (
+                  <label key={l.id} className="kertas-layer-row">
+                    <input type="radio" checked={selected.layer === l.id} onChange={() => onApply({ type: 'layer', id: selected.id, rect: selected.rect, layer: l.id })} />
+                    <span>{l.name}</span>
+                  </label>
+                ))}
+                {naming ? (
+                  <form
+                    className="kertas-object-newlayer"
+                    onSubmit={(e) => {
+                      e.preventDefault()
+                      if (name.trim()) onApply({ type: 'newLayer', id: selected.id, rect: selected.rect, name: name.trim() })
+                    }}
+                  >
+                    <input autoFocus value={name} placeholder="Layer name" onChange={(e) => setName(e.target.value)} />
+                    <button type="submit">Add</button>
+                  </form>
+                ) : (
+                  <button type="button" onClick={() => { setName(''); setNaming(true) }}>
+                    New layer...
+                  </button>
+                )}
+              </div>
+            )}
+          </div>
+        )
+      })()}
+    </div>
+  )
+}
diff --git a/apps/pdf/src/renderer/kertas/OcrLanguages.tsx b/apps/pdf/src/renderer/kertas/OcrLanguages.tsx
new file mode 100644
index 0000000..234721b
--- /dev/null
+++ b/apps/pdf/src/renderer/kertas/OcrLanguages.tsx
@@ -0,0 +1,84 @@
+// The languages text recognition reads (Kertas Office's offline engine). Picked here, next
+// to Recognize text, remembered on this computer, and sent to the main process.
+import { useEffect, useRef, useState, type ReactElement } from 'react'
+
+export const OCR_LANGUAGES = [
+  { id: 'eng', label: 'English' },
+  { id: 'msa', label: 'Malay' },
+  { id: 'mal', label: 'Malayalam' },
+  { id: 'ara', label: 'Arabic' },
+  { id: 'hin', label: 'Hindi' },
+  { id: 'tam', label: 'Tamil' },
+  { id: 'chi_sim', label: 'Chinese (simplified)' },
+]
+const KEY = 'kertas-ocr-langs'
+
+function saved(): string[] {
+  try {
+    const v = JSON.parse(localStorage.getItem(KEY) || 'null')
+    if (Array.isArray(v) && v.length && v.every((x) => OCR_LANGUAGES.some((l) => l.id === x))) return v
+  } catch {
+    /* default */
+  }
+  return ['eng']
+}
+
+export function OcrLanguages({ disabled }: { disabled: boolean }): ReactElement {
+  const [langs, setLangs] = useState<string[]>(saved)
+  const [open, setOpen] = useState(false)
+  const wrap = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    void window.pdfApi.kertasOcrLangs(langs)
+    try {
+      localStorage.setItem(KEY, JSON.stringify(langs))
+    } catch {
+      /* private mode */
+    }
+  }, [langs])
+  useEffect(() => {
+    if (!open) return
+    const away = (e: PointerEvent): void => {
+      if (!wrap.current?.contains(e.target as Node)) setOpen(false)
+    }
+    window.addEventListener('pointerdown', away, true)
+    return () => window.removeEventListener('pointerdown', away, true)
+  }, [open])
+  const names = OCR_LANGUAGES.filter((l) => langs.includes(l.id)).map((l) => l.label)
+  return (
+    <div ref={wrap} style={{ position: 'relative' }}>
+      <button
+        className="rb-big"
+        disabled={disabled}
+        data-tip={`Languages read in scans: ${names.join(', ')}`}
+        onClick={() => setOpen((v) => !v)}
+      >
+        <span className="rb-big-icon">
+          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+            <circle cx="12" cy="12" r="8.5" />
+            <path d="M3.5 12h17M12 3.5c2.4 2.6 3.5 5.4 3.5 8.5s-1.1 5.9-3.5 8.5c-2.4-2.6-3.5-5.4-3.5-8.5s1.1-5.9 3.5-8.5z" />
+          </svg>
+        </span>
+        <span>{names.length === 1 ? names[0] : `${names.length} languages`}</span>
+      </button>
+      {open && (
+        <div className="rb-drop rb-menu kertas-ocr-langs">
+          {OCR_LANGUAGES.map((l) => (
+            <label key={l.id} className="kertas-layer-row">
+              <input
+                type="checkbox"
+                checked={langs.includes(l.id)}
+                onChange={(e) =>
+                  setLangs((cur) => {
+                    const next = e.target.checked ? [...cur, l.id] : cur.filter((x) => x !== l.id)
+                    return next.length ? next : cur
+                  })
+                }
+              />
+              <span>{l.label}</span>
+            </label>
+          ))}
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/apps/pdf/src/renderer/kertas/StampButton.tsx b/apps/pdf/src/renderer/kertas/StampButton.tsx
new file mode 100644
index 0000000..50dd048
--- /dev/null
+++ b/apps/pdf/src/renderer/kertas/StampButton.tsx
@@ -0,0 +1,67 @@
+// The Stamp button of the Annotate tab: a list of stamps; picking one arms placement.
+import { useEffect, useRef, useState, type ReactElement } from 'react'
+import { STAMPS, type StampKind } from './stamps'
+
+export function StampButton({
+  active,
+  disabled,
+  onPick,
+}: {
+  active: boolean
+  disabled: boolean
+  onPick: (kind: StampKind) => void
+}): ReactElement {
+  const [open, setOpen] = useState(false)
+  const wrap = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    if (!open) return
+    const away = (e: PointerEvent): void => {
+      if (!wrap.current?.contains(e.target as Node)) setOpen(false)
+    }
+    const key = (e: KeyboardEvent): void => {
+      if (e.key === 'Escape') setOpen(false)
+    }
+    window.addEventListener('pointerdown', away, true)
+    window.addEventListener('keydown', key)
+    return () => {
+      window.removeEventListener('pointerdown', away, true)
+      window.removeEventListener('keydown', key)
+    }
+  }, [open])
+  return (
+    <div className="rb-drop-wrap" ref={wrap} style={{ position: 'relative' }}>
+      <button
+        className={`rb-big${active ? ' active' : ''}`}
+        disabled={disabled}
+        data-tip="Stamp: approved, paid, draft and more"
+        onClick={() => setOpen((v) => !v)}
+      >
+        <span className="rb-big-icon">
+          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+            <path d="M9.5 3.5h5l-1 7h-3z" />
+            <path d="M5 13.5c0-1.6 1.3-3 3-3h8c1.7 0 3 1.4 3 3v2H5z" />
+            <path d="M5 19.5h14" />
+          </svg>
+        </span>
+        <span>Stamp</span>
+      </button>
+      {open && (
+        <div className="rb-drop rb-menu kertas-stamp-menu">
+          {STAMPS.map((s) => (
+            <button
+              key={s.id}
+              onClick={() => {
+                setOpen(false)
+                onPick(s)
+              }}
+            >
+              <span className="kertas-stamp-chip" style={{ color: s.color, borderColor: s.color }}>
+                {s.label}
+              </span>
+            </button>
+          ))}
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/apps/pdf/src/renderer/kertas/layers.ts b/apps/pdf/src/renderer/kertas/layers.ts
new file mode 100644
index 0000000..a4e0a10
--- /dev/null
+++ b/apps/pdf/src/renderer/kertas/layers.ts
@@ -0,0 +1,53 @@
+// The PDF's layers (optional content groups): which are shown is kept here, per open
+// document, and every page drawing reads it, so hiding a layer redraws the pages without it.
+import { useSyncExternalStore } from 'react'
+import type { PDFDocumentProxy } from 'pdfjs-dist'
+
+type Config = Awaited<ReturnType<PDFDocumentProxy['getOptionalContentConfig']>>
+
+const configs = new WeakMap<PDFDocumentProxy, Promise<Config>>()
+let rev = 0
+const listeners = new Set<() => void>()
+
+/** The one visibility setting of this document that every page drawing uses */
+export function layerConfig(doc: PDFDocumentProxy): Promise<Config> {
+  let p = configs.get(doc)
+  if (!p) {
+    p = doc.getOptionalContentConfig()
+    configs.set(doc, p)
+  }
+  return p
+}
+
+export interface LayerRow {
+  id: string
+  name: string
+  visible: boolean
+}
+
+export async function listLayers(doc: PDFDocumentProxy): Promise<LayerRow[]> {
+  const config = await layerConfig(doc)
+  const rows: LayerRow[] = []
+  for (const [id, group] of config) {
+    rows.push({ id, name: group.name || 'Unnamed layer', visible: group.visible })
+  }
+  return rows
+}
+
+export async function setLayerVisible(doc: PDFDocumentProxy, id: string, visible: boolean): Promise<void> {
+  const config = await layerConfig(doc)
+  config.setVisibility(id, visible)
+  rev++
+  for (const fn of listeners) fn()
+}
+
+/** Changes whenever a layer is shown or hidden; page drawings redraw on it */
+export function useLayerRev(): number {
+  return useSyncExternalStore(
+    (fn) => {
+      listeners.add(fn)
+      return () => listeners.delete(fn)
+    },
+    () => rev,
+  )
+}
