--- /dev/null
+++ b/apps/docs/src/main/kertas-pdf-entry.ts
@@ -0,0 +1,48 @@
+// Entry for Kertas Office's PDF to Word and PDF to Excel converters. It is built as a file of its
+// own and run in a separate process, so a long conversion never holds up the
+// window; nothing in it needs the app.
+import { readFileSync } from 'node:fs'
+import { convertPdfToDocx, convertPdfToXlsx } from '../../../../packages/pdf2docx/src'
+import type { PdfiumModule } from '../../../../packages/pdf2docx/src'
+
+let pdfium: Promise<PdfiumModule> | null = null
+const engine = (wasmPath: string): Promise<PdfiumModule> => {
+  pdfium ??= (async () => {
+    const { init } = (await import('@embedpdf/pdfium')) as unknown as {
+      init(overrides: object): Promise<object>
+    }
+    const raw = readFileSync(wasmPath)
+    const wasmBinary = raw.buffer.slice(raw.byteOffset, raw.byteOffset + raw.byteLength)
+    const wrapped = (await init({ wasmBinary, thisProgram: 'kertas-pdf' })) as { pdfium?: unknown }
+    const m = (wrapped.pdfium ?? wrapped) as PdfiumModule & { _PDFiumExt_Init(): void }
+    m._PDFiumExt_Init()
+    return m
+  })()
+  return pdfium
+}
+
+/** PDF bytes to workbook bytes, on this computer: the tables found on each page. */
+export async function convertPdfBytesToXlsx(
+  pdf: Uint8Array,
+  wasmPath: string,
+  onProgress?: (page: number, total: number) => void,
+): Promise<Uint8Array> {
+  const result = await convertPdfToXlsx(pdf, {
+    pdfium: await engine(wasmPath),
+    ...(onProgress ? { onProgress } : {}),
+  })
+  return result.xlsx
+}
+
+/** PDF bytes to Word bytes, on this computer. `wasmPath` is the PDFium engine file. */
+export async function convertPdfBytesToDocx(
+  pdf: Uint8Array,
+  wasmPath: string,
+  onProgress?: (page: number, total: number) => void,
+): Promise<Uint8Array> {
+  const result = await convertPdfToDocx(pdf, {
+    pdfium: await engine(wasmPath),
+    ...(onProgress ? { onProgress } : {}),
+  })
+  return result.docx
+}
