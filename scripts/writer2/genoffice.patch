new file mode 100644
index 0000000..19e997e
--- /dev/null
+++ b/apps/docs/kertas.vite.config.ts
@@ -0,0 +1,36 @@
+import { resolve } from 'node:path'
+import react from '@vitejs/plugin-react'
+import { defineConfig, externalizeDepsPlugin } from 'electron-vite'
+
+// Build used when Kertas Office hosts this editor. Same sources as the normal
+// build; the main-process entry exports the hosting functions instead of
+// starting an app, and everything except electron is bundled in.
+const localAlias = {
+  '@genoffice/docx-engine/lazy-media': resolve(__dirname, '../../packages/docx-engine/src/lazy-media.ts'),
+  '@genoffice/docx-engine/zip-splice': resolve(__dirname, '../../packages/docx-engine/src/zip-splice.ts'),
+  '@genoffice/docx-engine': resolve(__dirname, '../../packages/docx-engine/src/index.ts'),
+}
+
+export default defineConfig({
+  main: {
+    resolve: { alias: localAlias },
+    build: {
+      externalizeDeps: false,
+      outDir: 'out-kertas/main',
+      rollupOptions: {
+        input: resolve(__dirname, 'src/main/kertas-entry.ts'),
+        external: ['electron', /^node:/],
+        output: { format: 'cjs', entryFileNames: 'index.cjs', chunkFileNames: '[name]-[hash].cjs' },
+      },
+    },
+  },
+  preload: {
+    plugins: [externalizeDepsPlugin({ exclude: ['@genoffice/electron-utils'] })],
+    build: { outDir: 'out-kertas/preload' },
+  },
+  renderer: {
+    plugins: [react()],
+    resolve: { alias: localAlias },
+    build: { outDir: 'out-kertas/renderer' },
+  },
+})
