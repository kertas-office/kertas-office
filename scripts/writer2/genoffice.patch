+++ b/apps/docs/src/renderer/kertas/form-fields.ts
@@ -0,0 +1,513 @@
+// Kertas Office: fillable form fields.
+//
+// A field is an inline content control (w:sdt): a text field, a drop-down
+// list, a date picker or a tick box. The editor holds one as text carrying the
+// `ctrlField` mark (the tick box as `ctrlCheckbox`), with the control's own
+// properties (w:sdtPr) kept on the mark and written back around the text on
+// save, so Word and LibreOffice see the same field.
+//
+// This file is the behaviour: what a click or a key does inside a field, the
+// small pop-ups for picking a choice or a date, and inserting new fields.
+
+import { Extension, type Editor } from '@tiptap/core'
+import type { Mark as PmMark, Node as PmNode } from '@tiptap/pm/model'
+import { Plugin, TextSelection } from '@tiptap/pm/state'
+import type { EditorView } from '@tiptap/pm/view'
+import { ctrlFieldKind, ctrlFieldTitle } from '../editor/marks'
+
+export type FormFieldKind = 'text' | 'checkbox' | 'list' | 'date'
+
+/** one field in the document: where it is, what it holds, what it is */
+export interface FieldRange {
+  from: number
+  to: number
+  text: string
+  sdtPr: string
+  key: number
+  /** the marks of its first character, the control's own left out */
+  marks: readonly PmMark[]
+}
+
+const PLACEHOLDER = { text: 'Click here to type', list: 'Choose an item', date: 'Pick a date', rich: 'Click here to type' }
+const PLACEHOLDER_GREY = '808080'
+export const DATE_FORMATS = ['d MMMM yyyy', 'dd/MM/yyyy', 'MM/dd/yyyy', 'yyyy-MM-dd', 'd MMM yyyy', 'MMMM d, yyyy', 'dddd, d MMMM yyyy']
+
+// ---- the control's properties (w:sdtPr) -------------------------------------
+
+const esc = (v: string): string =>
+  v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
+const unesc = (v: string): string =>
+  v.replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')
+
+const showsPlaceholder = (sdtPr: string): boolean => /<w:showingPlcHdr\b/.test(sdtPr)
+const withoutPlaceholder = (sdtPr: string): string => sdtPr.replace(/<w:showingPlcHdr\b[^>]*\/>/, '')
+function withPlaceholder(sdtPr: string): string {
+  if (showsPlaceholder(sdtPr)) return sdtPr
+  // CT_SdtPr order: w:showingPlcHdr comes before the element naming the control's type
+  const at = sdtPr.search(/<w:(?:dataBinding|text|dropDownList|comboBox|date|richText|picture|docPartObj|docPartList|group)\b|<\/w:sdtPr>/)
+  return at < 0 ? sdtPr : `${sdtPr.slice(0, at)}<w:showingPlcHdr/>${sdtPr.slice(at)}`
+}
+
+export function listItems(sdtPr: string): Array<{ text: string; value: string }> {
+  const out: Array<{ text: string; value: string }> = []
+  for (const m of sdtPr.matchAll(/<w:listItem\b([^>]*)\/>/g)) {
+    const value = /\bw:value="([^"]*)"/.exec(m[1])?.[1]
+    const text = /\bw:displayText="([^"]*)"/.exec(m[1])?.[1] ?? value
+    if (text !== undefined) out.push({ text: unesc(text), value: unesc(value ?? text) })
+  }
+  return out
+}
+
+export const dateFormatOf = (sdtPr: string): string =>
+  unesc(/<w:dateFormat\b[^>]*\bw:val="([^"]*)"/.exec(sdtPr)?.[1] ?? '') || 'd MMMM yyyy'
+
+const withFullDate = (sdtPr: string, iso: string): string =>
+  sdtPr.replace(/<w:date\b[^>]*?(\/?)>/, (_all, selfClosing: string) =>
+    selfClosing ? `<w:date w:fullDate="${iso}T00:00:00Z"/>` : `<w:date w:fullDate="${iso}T00:00:00Z">`,
+  )
+
+const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
+const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
+
+/** a date in a Word date format (d, dd, ddd, dddd, M, MM, MMM, MMMM, yy, yyyy) */
+export function formatDate(iso: string, format: string): string {
+  const [y, m, d] = iso.split('-').map(Number)
+  if (!y || !m || !d) return iso
+  const weekday = new Date(Date.UTC(y, m - 1, d)).getUTCDay()
+  return format.replace(/dddd|ddd|dd|d|MMMM|MMM|MM|M|yyyy|yy|'[^']*'/g, (token) => {
+    switch (token) {
+      case 'dddd': return DAYS[weekday]
+      case 'ddd': return DAYS[weekday].slice(0, 3)
+      case 'dd': return String(d).padStart(2, '0')
+      case 'd': return String(d)
+      case 'MMMM': return MONTHS[m - 1]
+      case 'MMM': return MONTHS[m - 1].slice(0, 3)
+      case 'MM': return String(m).padStart(2, '0')
+      case 'M': return String(m)
+      case 'yyyy': return String(y)
+      case 'yy': return String(y).slice(-2)
+      default: return token.slice(1, -1)
+    }
+  })
+}
+
+const newId = (): number => 1 + Math.floor(Math.random() * 2_000_000_000)
+
+export interface FieldSpec {
+  title?: string
+  choices?: string[]
+  format?: string
+}
+
+export function buildSdtPr(kind: Exclude<FormFieldKind, 'checkbox'>, spec: FieldSpec, placeholder: boolean): string {
+  const head = `${spec.title ? `<w:alias w:val="${esc(spec.title)}"/>` : ''}<w:id w:val="${newId()}"/>${placeholder ? '<w:showingPlcHdr/>' : ''}`
+  if (kind === 'list') {
+    const items = (spec.choices ?? []).map((c) => `<w:listItem w:displayText="${esc(c)}" w:value="${esc(c)}"/>`).join('')
+    return `<w:sdtPr>${head}<w:dropDownList>${items}</w:dropDownList></w:sdtPr>`
+  }
+  if (kind === 'date') {
+    return `<w:sdtPr>${head}<w:date><w:dateFormat w:val="${esc(spec.format || 'd MMMM yyyy')}"/><w:lid w:val="en-US"/><w:storeMappedDataAs w:val="dateTime"/><w:calendar w:val="gregorian"/></w:date></w:sdtPr>`
+  }
+  return `<w:sdtPr>${head}<w:text/></w:sdtPr>`
+}
+
+export const buildCheckboxSdtPr = (title: string): string =>
+  `<w:sdtPr>${title ? `<w:alias w:val="${esc(title)}"/>` : ''}<w:id w:val="${newId()}"/>` +
+  '<w14:checkbox><w14:checked w14:val="0"/><w14:checkedState w14:val="2612" w14:font="MS Gothic"/>' +
+  '<w14:uncheckedState w14:val="2610" w14:font="MS Gothic"/></w14:checkbox></w:sdtPr>'
+
+/** the same properties with a new title, choices or date format */
+export function editSdtPr(sdtPr: string, spec: FieldSpec): string {
+  let xml = sdtPr
+  if (spec.title !== undefined) {
+    xml = xml.replace(/<w:alias\b[^>]*\/>/, '')
+    if (spec.title) xml = xml.replace(/<w:sdtPr>/, `<w:sdtPr><w:alias w:val="${esc(spec.title)}"/>`)
+  }
+  if (spec.choices) {
+    const items = spec.choices.map((c) => `<w:listItem w:displayText="${esc(c)}" w:value="${esc(c)}"/>`).join('')
+    xml = xml.replace(/<w:(dropDownList|comboBox)\b([^>]*?)(?:\/>|>[\s\S]*?<\/w:\1>)/, (_a, tag: string, attrs: string) => `<w:${tag}${attrs}>${items}</w:${tag}>`)
+  }
+  if (spec.format) {
+    xml = /<w:dateFormat\b/.test(xml)
+      ? xml.replace(/<w:dateFormat\b[^>]*\/>/, `<w:dateFormat w:val="${esc(spec.format)}"/>`)
+      : xml.replace(/<w:date\b([^>]*?)\/>/, `<w:date$1><w:dateFormat w:val="${esc(spec.format)}"/></w:date>`)
+  }
+  return xml
+}
+
+// ---- finding and changing a field in the document ---------------------------
+
+const fieldMark = (node: PmNode | null | undefined): PmMark | undefined =>
+  node?.isText ? node.marks.find((m) => m.type.name === 'ctrlField') : undefined
+
+/** the field at `pos`: the one the position is inside, or touching */
+export function fieldAt(doc: PmNode, pos: number): FieldRange | null {
+  if (pos < 0 || pos > doc.content.size) return null
+  const $pos = doc.resolve(pos)
+  const parent = $pos.parent
+  if (!parent.isTextblock) return null
+  const mark = fieldMark($pos.nodeAfter) ?? fieldMark($pos.nodeBefore)
+  if (!mark) return null
+  const same = (node: PmNode): boolean => {
+    const m = fieldMark(node)
+    return !!m && m.attrs.key === mark.attrs.key && m.attrs.sdtPr === mark.attrs.sdtPr
+  }
+  // the run of neighbouring text nodes that belong to this control and include pos
+  let offset = $pos.start()
+  let from = -1
+  let to = -1
+  let text = ''
+  let marks: readonly PmMark[] = []
+  for (let i = 0; i < parent.childCount; i++) {
+    const child = parent.child(i)
+    const end = offset + child.nodeSize
+    if (same(child)) {
+      if (from < 0) { from = offset; text = ''; marks = child.marks.filter((m) => m.type.name !== 'ctrlField') }
+      text += child.text ?? ''
+      to = end
+    } else if (from >= 0) {
+      if (pos >= from && pos <= to) break
+      from = -1
+    }
+    offset = end
+  }
+  if (from < 0 || pos < from || pos > to) return null
+  return { from, to, text, sdtPr: String(mark.attrs.sdtPr ?? ''), key: Number(mark.attrs.key ?? 0), marks }
+}
+
+const isPlaceholderStyle = (m: PmMark): boolean =>
+  m.type.name === 'docTextStyle' &&
+  (m.attrs.styleId === 'PlaceholderText' || /^(808080|7f7f7f|666666)$/i.test(String(m.attrs.color ?? '')))
+
+/** put `text` in the field, as its content or as its placeholder */
+function setField(view: EditorView, field: FieldRange, text: string, sdtPr: string, opts: { placeholder?: boolean; select?: boolean } = {}): void {
+  const { schema } = view.state
+  const marks: PmMark[] = field.marks.filter((m) => !isPlaceholderStyle(m))
+  if (opts.placeholder && schema.marks.docTextStyle) marks.push(schema.marks.docTextStyle.create({ color: PLACEHOLDER_GREY }))
+  marks.push(schema.marks.ctrlField.create({ sdtPr, key: field.key }))
+  const tr = view.state.tr.replaceWith(field.from, field.to, schema.text(text, marks))
+  const end = field.from + text.length
+  tr.setSelection(opts.select ? TextSelection.create(tr.doc, field.from, end) : TextSelection.create(tr.doc, end))
+  view.dispatch(tr.scrollIntoView())
+}
+
+const fill = (view: EditorView, field: FieldRange, text: string, sdtPr = field.sdtPr): void =>
+  setField(view, field, text, withoutPlaceholder(sdtPr))
+
+function clear(view: EditorView, field: FieldRange): void {
+  const kind = ctrlFieldKind(field.sdtPr)
+  setField(view, field, PLACEHOLDER[kind], withPlaceholder(field.sdtPr), { placeholder: true, select: true })
+}
+
+// ---- pop-ups ----------------------------------------------------------------
+
+let openPopup: HTMLElement | null = null
+function closePopup(): void {
+  openPopup?.remove()
+  openPopup = null
+  document.removeEventListener('mousedown', onOutside, true)
+  document.removeEventListener('keydown', onEscape, true)
+}
+function onOutside(e: MouseEvent): void {
+  if (openPopup && !openPopup.contains(e.target as Node)) closePopup()
+}
+function onEscape(e: KeyboardEvent): void {
+  if (e.key === 'Escape') { e.stopPropagation(); closePopup() }
+}
+
+function popupAt(view: EditorView, pos: number, className: string): HTMLElement {
+  closePopup()
+  const el = document.createElement('div')
+  el.className = `kertas-field-popup ${className}`
+  const at = view.coordsAtPos(pos)
+  el.style.left = `${Math.max(8, Math.min(at.left, window.innerWidth - 280))}px`
+  el.style.top = `${Math.min(at.bottom + 4, window.innerHeight - 60)}px`
+  document.body.appendChild(el)
+  openPopup = el
+  // after this click has finished, so it does not close what it opened
+  setTimeout(() => {
+    document.addEventListener('mousedown', onOutside, true)
+    document.addEventListener('keydown', onEscape, true)
+  })
+  return el
+}
+
+function openChoices(view: EditorView, field: FieldRange): void {
+  const items = listItems(field.sdtPr)
+  const el = popupAt(view, field.from, 'kertas-field-menu')
+  if (!items.length) {
+    const empty = document.createElement('div')
+    empty.className = 'kertas-field-empty'
+    empty.textContent = 'This list has no choices yet. Add some with Insert > Form field > Field properties.'
+    el.appendChild(empty)
+    return
+  }
+  for (const item of items) {
+    const btn = document.createElement('button')
+    btn.type = 'button'
+    btn.textContent = item.text
+    if (item.text === field.text && !showsPlaceholder(field.sdtPr)) btn.className = 'is-current'
+    btn.addEventListener('click', () => {
+      closePopup()
+      const now = fieldAt(view.state.doc, field.from)
+      if (now) fill(view, now, item.text)
+      view.focus()
+    })
+    el.appendChild(btn)
+  }
+  const none = document.createElement('button')
+  none.type = 'button'
+  none.className = 'is-clear'
+  none.textContent = 'Clear'
+  none.addEventListener('click', () => {
+    closePopup()
+    const now = fieldAt(view.state.doc, field.from)
+    if (now) clear(view, now)
+    view.focus()
+  })
+  el.appendChild(none)
+}
+
+function openDate(view: EditorView, field: FieldRange): void {
+  const el = popupAt(view, field.from, 'kertas-field-date')
+  const input = document.createElement('input')
+  input.type = 'date'
+  const current = /\bw:fullDate="(\d{4}-\d{2}-\d{2})/.exec(field.sdtPr)?.[1]
+  const today = new Date()
+  input.value = current ?? `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`
+  const apply = (iso: string): void => {
+    closePopup()
+    const now = fieldAt(view.state.doc, field.from)
+    if (now && iso) fill(view, now, formatDate(iso, dateFormatOf(now.sdtPr)), withFullDate(now.sdtPr, iso))
+    view.focus()
+  }
+  const ok = document.createElement('button')
+  ok.type = 'button'
+  ok.className = 'is-primary'
+  ok.textContent = 'Set date'
+  ok.addEventListener('click', () => apply(input.value))
+  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); apply(input.value) } })
+  const none = document.createElement('button')
+  none.type = 'button'
+  none.textContent = 'Clear'
+  none.addEventListener('click', () => {
+    closePopup()
+    const now = fieldAt(view.state.doc, field.from)
+    if (now) clear(view, now)
+    view.focus()
+  })
+  el.append(input, ok, none)
+  input.focus()
+}
+
+interface DialogField { id: string; label: string; value: string; type?: 'text' | 'textarea' | 'select'; options?: string[] }
+
+/** a small form over the page; resolves with the values, or null when cancelled */
+function dialog(title: string, hint: string, fields: DialogField[], okLabel: string, validate?: (v: Record<string, string>) => string | null): Promise<Record<string, string> | null> {
+  closePopup()
+  return new Promise((resolve) => {
+    const back = document.createElement('div')
+    back.className = 'kertas-field-dialog-back'
+    const box = document.createElement('form')
+    box.className = 'kertas-field-dialog'
+    const h = document.createElement('h3')
+    h.textContent = title
+    const p = document.createElement('p')
+    p.textContent = hint
+    box.append(h, p)
+    const inputs = new Map<string, HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>()
+    for (const f of fields) {
+      const label = document.createElement('label')
+      label.textContent = f.label
+      let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
+      if (f.type === 'textarea') { input = document.createElement('textarea'); input.rows = 5 }
+      else if (f.type === 'select') {
+        input = document.createElement('select')
+        for (const o of f.options ?? []) { const opt = document.createElement('option'); opt.value = o; opt.textContent = `${o}   (${formatDate('2026-01-05', o)})`; input.appendChild(opt) }
+      } else { input = document.createElement('input'); input.type = 'text' }
+      input.value = f.value
+      label.appendChild(input)
+      box.appendChild(label)
+      inputs.set(f.id, input)
+    }
+    const error = document.createElement('div')
+    error.className = 'kertas-field-error'
+    const row = document.createElement('div')
+    row.className = 'kertas-field-actions'
+    const cancel = document.createElement('button')
+    cancel.type = 'button'
+    cancel.textContent = 'Cancel'
+    const ok = document.createElement('button')
+    ok.type = 'submit'
+    ok.className = 'is-primary'
+    ok.textContent = okLabel
+    row.append(cancel, ok)
+    box.append(error, row)
+    back.appendChild(box)
+    document.body.appendChild(back)
+    const done = (values: Record<string, string> | null): void => { back.remove(); resolve(values) }
+    cancel.addEventListener('click', () => done(null))
+    back.addEventListener('mousedown', (e) => { if (e.target === back) done(null) })
+    box.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); done(null) } })
+    box.addEventListener('submit', (e) => {
+      e.preventDefault()
+      const values: Record<string, string> = {}
+      for (const [id, input] of inputs) values[id] = input.value
+      const problem = validate?.(values) ?? null
+      if (problem) { error.textContent = problem; return }
+      done(values)
+    })
+    ;(inputs.values().next().value as HTMLElement | undefined)?.focus()
+  })
+}
+
+const choicesOf = (text: string): string[] => text.split('\n').map((c) => c.trim()).filter(Boolean)
+
+// ---- inserting and editing --------------------------------------------------
+
+/** the field the cursor is in, for the ribbon to enable "Field properties" */
+export function currentField(editor: Editor): FieldRange | null {
+  return fieldAt(editor.state.doc, editor.state.selection.from)
+}
+
+export async function insertFormField(editor: Editor, kind: FormFieldKind): Promise<void> {
+  if (!editor.isEditable) return
+  const { schema } = editor.state
+  if (kind === 'checkbox') {
+    editor.chain().focus().insertContent({ type: 'text', text: '\u2610', marks: [{ type: 'ctrlCheckbox', attrs: { sdtPr: buildCheckboxSdtPr('Tick box') } }] }).run()
+    return
+  }
+  const spec: FieldSpec = { title: kind === 'text' ? 'Text field' : kind === 'list' ? 'Dropdown list' : 'Date picker' }
+  if (kind === 'list') {
+    const v = await dialog('Insert dropdown list', 'A list to pick one choice from. It can be filled in here, in Word and in LibreOffice.', [
+      { id: 'title', label: 'Title (shown when the field is pointed at)', value: spec.title ?? '' },
+      { id: 'choices', label: 'Choices, one per line', value: 'First choice\nSecond choice\nThird choice', type: 'textarea' },
+    ], 'Insert', (values) => (choicesOf(values.choices).length ? null : 'Add at least one choice'))
+    if (!v) return
+    spec.title = v.title.trim()
+    spec.choices = choicesOf(v.choices)
+  } else if (kind === 'date') {
+    const v = await dialog('Insert date picker', 'A date chosen from a calendar. It can be filled in here, in Word and in LibreOffice.', [
+      { id: 'title', label: 'Title (shown when the field is pointed at)', value: spec.title ?? '' },
+      { id: 'format', label: 'Date format', value: 'd MMMM yyyy', type: 'select', options: DATE_FORMATS },
+    ], 'Insert')
+    if (!v) return
+    spec.title = v.title.trim()
+    spec.format = v.format
+  }
+  const placeholder = PLACEHOLDER[kind]
+  const marks: Array<{ type: string; attrs: Record<string, unknown> }> = []
+  if (schema.marks.docTextStyle) marks.push({ type: 'docTextStyle', attrs: { color: PLACEHOLDER_GREY } })
+  marks.push({ type: 'ctrlField', attrs: { sdtPr: buildSdtPr(kind, spec, true), key: newId() } })
+  editor.chain().focus().insertContent({ type: 'text', text: placeholder, marks }).run()
+  // what is typed next belongs after the field, not inside it
+  editor.view.dispatch(editor.state.tr.setStoredMarks([]))
+}
+
+export async function editFieldProperties(editor: Editor): Promise<void> {
+  const field = currentField(editor)
+  if (!field || !editor.isEditable) return
+  const kind = ctrlFieldKind(field.sdtPr)
+  const fields: DialogField[] = [{ id: 'title', label: 'Title (shown when the field is pointed at)', value: ctrlFieldTitle(field.sdtPr) }]
+  if (kind === 'list') fields.push({ id: 'choices', label: 'Choices, one per line', value: listItems(field.sdtPr).map((i) => i.text).join('\n'), type: 'textarea' })
+  if (kind === 'date') fields.push({ id: 'format', label: 'Date format', value: dateFormatOf(field.sdtPr), type: 'select', options: [...new Set([dateFormatOf(field.sdtPr), ...DATE_FORMATS])] })
+  const v = await dialog('Field properties', 'Changes apply to this field only.', fields, 'Save', (values) => (kind === 'list' && !choicesOf(values.choices).length ? 'Add at least one choice' : null))
+  if (!v) return
+  const now = fieldAt(editor.state.doc, field.from)
+  if (!now) return
+  let sdtPr = editSdtPr(now.sdtPr, { title: v.title.trim(), ...(kind === 'list' ? { choices: choicesOf(v.choices) } : {}), ...(kind === 'date' ? { format: v.format } : {}) })
+  let text = now.text
+  // a date already picked is shown again in the new format
+  const iso = /\bw:fullDate="(\d{4}-\d{2}-\d{2})/.exec(sdtPr)?.[1]
+  if (kind === 'date' && iso && !showsPlaceholder(sdtPr)) text = formatDate(iso, dateFormatOf(sdtPr))
+  // a choice that no longer exists goes back to "Choose an item"
+  if (kind === 'list' && !showsPlaceholder(sdtPr) && !listItems(sdtPr).some((i) => i.text === text)) {
+    sdtPr = withPlaceholder(sdtPr)
+    text = PLACEHOLDER.list
+  }
+  setField(editor.view, now, text, sdtPr, { placeholder: showsPlaceholder(sdtPr) })
+  editor.view.focus()
+}
+
+// ---- behaviour inside a field -----------------------------------------------
+
+export const FormFieldsExtension = Extension.create({
+  name: 'kertasFormFields',
+
+  addProseMirrorPlugins() {
+    return [
+      new Plugin({
+        view: () => ({ destroy: closePopup }),
+        props: {
+          handleClick(view, pos, event) {
+            if (event.button !== 0 || event.detail > 1) return false
+            if (event.shiftKey || event.altKey || event.ctrlKey || event.metaKey) return false
+            const field = fieldAt(view.state.doc, pos)
+            if (!field) return false
+            // a click just past the field's edge is a click beside it, not on it
+            const target = event.target instanceof Element ? event.target.closest('[data-ctrl-field]') : null
+            if (!target) return false
+            const kind = ctrlFieldKind(field.sdtPr)
+            if (kind === 'list' && !/<w:comboBox\b/.test(field.sdtPr)) { openChoices(view, field); return true }
+            if (kind === 'list') { openChoices(view, field); return false }
+            if (kind === 'date') { openDate(view, field); return true }
+            if (showsPlaceholder(field.sdtPr)) {
+              // the placeholder is replaced as a whole by what is typed
+              view.dispatch(view.state.tr.setSelection(TextSelection.create(view.state.doc, field.from, field.to)))
+              return true
+            }
+            return false
+          },
+
+          handleTextInput(view, from, _to, text) {
+            const field = fieldAt(view.state.doc, from)
+            if (!field) return false
+            const kind = ctrlFieldKind(field.sdtPr)
+            const typable = kind === 'text' || kind === 'rich' || /<w:comboBox\b/.test(field.sdtPr)
+            const { selection, schema } = view.state
+            // with the cursor at the field's edge, typing goes beside it: before it as usual,
+            // and after an empty or picked field (there is no "end of its text" to add to)
+            if (selection.empty && from === field.from) return false
+            if (selection.empty && from === field.to && (!typable || showsPlaceholder(field.sdtPr))) {
+              const marks = field.marks.filter((m) => !isPlaceholderStyle(m))
+              view.dispatch(view.state.tr.insert(from, schema.text(text, marks)).scrollIntoView())
+              return true
+            }
+            // a drop-down or a date is picked, not typed
+            if (!typable) { if (kind === 'list') openChoices(view, field); else openDate(view, field); return true }
+            if (showsPlaceholder(field.sdtPr)) { fill(view, field, text); return true }
+            return false
+          },
+
+          handleKeyDown(view, event) {
+            const { selection } = view.state
+            if (event.key === 'Backspace' || event.key === 'Delete') {
+              const field = fieldAt(view.state.doc, selection.from)
+              if (!field) return false
+              if (showsPlaceholder(field.sdtPr)) {
+                // nothing to delete inside an empty field; with the whole of it selected the key removes the field
+                return !(selection.from === field.from && selection.to === field.to)
+              }
+              const whole = selection.from <= field.from && selection.to >= field.to && !selection.empty
+              const lastChar = selection.empty && field.text.length === 1 &&
+                ((event.key === 'Backspace' && selection.from === field.to) || (event.key === 'Delete' && selection.from === field.from))
+              const picked = ctrlFieldKind(field.sdtPr) !== 'text' && ctrlFieldKind(field.sdtPr) !== 'rich' && !/<w:comboBox\b/.test(field.sdtPr)
+              // emptying a field brings its placeholder back, as in Word, instead of removing the field
+              if (lastChar || picked || (whole && selection.from === field.from && selection.to === field.to)) { clear(view, field); return true }
+              return false
+            }
+            if (event.key === 'ArrowRight' && selection.empty && !event.shiftKey) {
+              // at the field's end with nothing after it: the next typing goes outside the field
+              const field = fieldAt(view.state.doc, selection.from)
+              if (field && selection.from === field.to && !selection.$from.nodeAfter) {
+                view.dispatch(view.state.tr.setStoredMarks(field.marks.filter((m) => !isPlaceholderStyle(m))))
+                return true
+              }
+            }
+            return false
+          },
+        },
+      }),
+    ]
+  },
+})
