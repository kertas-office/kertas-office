diff --git a/apps/kertas-build.ts b/apps/kertas-build.ts
new file mode 100644
index 0000000..d33493d
--- /dev/null
+++ b/apps/kertas-build.ts
@@ -0,0 +1,194 @@
+import { readdirSync, readFileSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import type { Plugin } from 'vite'
+
+// Shared by the builds Kertas Office makes of the three editors.
+// Kertas Office has no AI assistant, and it is left out of the build rather than
+// switched off: the assistant's panel, its tools and the packages that talk to AI
+// services resolve to stand-ins, so their code never reaches the bundle.
+const AI_PACKAGES = /^@genoffice\/(ai-provider|ai-search|project-store|file-parse)(\/|$)/
+export type AiModules = Array<[RegExp, string]>
+// Every name the sources import from those packages, found by reading the sources, so
+// the stand-in can export each one. A name left out would be a build error, never a
+// silent `undefined`.
+const AI_STANDIN = '\0kertas-no-ai-package'
+function importedAiNames(): string[] {
+  const names = new Set<string>()
+  const roots = [...['docs', 'sheets', 'pdf'].map((app) => resolve(__dirname, app, 'src')), resolve(__dirname, '../packages')]
+  const visit = (dir: string): void => {
+    for (const entry of readdirSync(dir, { withFileTypes: true })) {
+      if (entry.name === 'node_modules' || entry.name === 'dist' || entry.name.startsWith('.')) continue
+      const full = join(dir, entry.name)
+      if (entry.isDirectory()) visit(full)
+      else if (/\.(ts|tsx)$/.test(entry.name) && !/\.test\.|\.d\.ts$/.test(entry.name)) {
+        const code = readFileSync(full, 'utf8')
+        const stmt = /(?:import|export)\s+(type\s+)?\{([^}]*)\}\s*from\s*['"](@genoffice\/[^'"]+)['"]/g
+        let m: RegExpExecArray | null
+        while ((m = stmt.exec(code)) !== null) {
+          if (m[1] || !AI_PACKAGES.test(m[3])) continue
+          for (const part of m[2].split(',')) {
+            const name = part.trim().replace(/^type\s+.*/, '').split(/\s+as\s+/)[0].trim()
+            if (name) names.add(name)
+          }
+        }
+      }
+    }
+  }
+  for (const root of roots) visit(root)
+  return [...names].sort()
+}
+// What each of those names is in Kertas's build: one inert value that can be called,
+// constructed, read from and iterated (as nothing) without doing anything.
+const standInSource = (): string =>
+  `const inert = new Proxy(function () {}, {
+  get: (_t, key) => key === Symbol.iterator ? function* () {} : key === Symbol.toPrimitive ? () => '' : key === 'then' ? undefined : key === 'prototype' ? Object.prototype : inert,
+  apply: () => inert,
+  construct: () => ({}),
+})
+${importedAiNames().map((name) => `export const ${name} = inert`).join('\n')}
+export default inert
+`
+
+export const kertasNoAi = (noAi: string, AI_MODULES: AiModules): Plugin => ({
+  name: 'kertas-no-ai',
+  enforce: 'pre',
+  load(id) {
+    return id === AI_STANDIN ? standInSource() : null
+  },
+  resolveId(source, importer) {
+    if (AI_PACKAGES.test(source)) return AI_STANDIN
+    if (!importer || importer.startsWith(noAi)) return null
+    for (const [pattern, file] of AI_MODULES) if (pattern.test(source)) return resolve(noAi, file)
+    return null
+  },
+})
+// The assistant's interface text goes too: its own string tables load empty, and
+// the few lines about it in the shared tables (sign-in and credit messages) are
+// taken out, so nothing in the build names an AI service.
+const AI_STRINGS = /[\\/]renderer[\\/]i18n[\\/]ai[\\/]([\w-]+)\.ts$/
+const STRING_TABLES = /[\\/](?:renderer[\\/]i18n[\\/](?:app|ribbon)[\\/][\w-]+|packages[\\/]i18n[\\/]src[\\/][\w-]+|main[\\/](?:docs|sheets|pdf)-main|renderer[\\/]i18n[\\/][\w-]+|renderer[\\/]i18n[\\/]dialogs[\\/][\w-]+)\.ts$/
+const AI_ENTRY =
+  /^[ \t]*(?:[A-Za-z_$][\w$]*|'[^'\n]+')\s*:\s*(?:\n\s*)?(?:'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"|`(?:[^`\\]|\\.)*`)\s*,?[ \t]*\n/gm
+export const kertasNoAiStrings = (): Plugin => ({
+  name: 'kertas-no-ai-strings',
+  enforce: 'pre',
+  load(id) {
+    const table = AI_STRINGS.exec(id.split('?')[0])
+    if (!table) return null
+    return `export const ${table[1].replace(/-(\w)/g, (_m, c: string) => c.toUpperCase())} = {}\n`
+  },
+  transform(code, id) {
+    if (!STRING_TABLES.test(id.split('?')[0]) || !/genspark|GenOffice/i.test(code)) return null
+    // and what is left names the app it is now part of
+    const kept = code.replace(AI_ENTRY, (entry) => (/genspark/i.test(entry) ? '' : entry))
+    return { code: kept.replace(/GenOffice(?= |[^\w./-]|$)/gm, 'Kertas Office'), map: null }
+  },
+})
+// The window's bridge loses the assistant's entries as well: each member of the
+// exposed object that talks on an assistant channel is taken out of the source.
+const PRELOAD = /[\\/]src[\\/]preload[\\/]index\.ts$/
+const AI_CHANNEL = /'(?:ai|kb|project):|docs:mcp-/
+// The page's own title is the editor's name in Kertas
+export const kertasTitle = (title: string): Plugin => ({
+  name: 'kertas-title',
+  transformIndexHtml: (html) => html.replace(/<title>[^<]*<\/title>/, `<title>${title}</title>`),
+})
+export const kertasNoAiBridge = (): Plugin => ({
+  name: 'kertas-no-ai-bridge',
+  enforce: 'pre',
+  transform(code, id) {
+    if (!PRELOAD.test(id.split('?')[0])) return null
+    const lines = code.split('\n')
+    const out: string[] = []
+    let member: string[] | null = null
+    const flush = () => {
+      if (member && !AI_CHANNEL.test(member.join('\n'))) out.push(...member)
+      member = null
+    }
+    for (const line of lines) {
+      // members of the exposed objects start at two spaces; anything at column 0 ends the object
+      if (/^ {2}[A-Za-z_$][\w$]*\s*[:(]/.test(line)) {
+        flush()
+        member = [line]
+      } else if (member && /^\S/.test(line)) {
+        flush()
+        out.push(line)
+      } else if (member) member.push(line)
+      else out.push(line)
+    }
+    flush()
+    const next = out
+      .join('\n')
+      .replace(/^const aiNamingApi = \{\s*\}\n/m, '')
+      .replace(/^contextBridge\.exposeInMainWorld\('aiNamingApi', aiNamingApi\)\n/m, '')
+      .replace(/^const projectApi[^\n]*= \{\s*\}\n/m, 'const projectApi = {}\n')
+    return { code: next, map: null }
+  },
+})
+
+
+// the bundled fonts keep their own file names apart from the original product's name
+export const kertasAssetNames = (asset: { names?: string[]; name?: string }): string =>
+  `assets/${String(asset.names?.[0] ?? asset.name ?? 'asset').replace(/^GenOffice/, 'Kertas').replace(/(\.[^.]+)$/, '-[hash]$1')}`
+
+// The spreadsheet and PDF pages call their bridge in too many places to take the
+// assistant's entries out one by one, so their bridge is closed to the assistant's
+// channels instead: a call on one never leaves the page (it answers with nothing),
+// and nothing on such a channel is ever listened for.
+const QUIET = String.raw`/^(?:ai|kb|project):|:(?:mcp-|ai-|files-)|^pdf:(?:create-document|generate-image)$/`
+export const kertasQuietBridge = (): Plugin => ({
+  name: 'kertas-quiet-bridge',
+  enforce: 'pre',
+  transform(code, id) {
+    if (!PRELOAD.test(id.split('?')[0])) return null
+    const from = /import \{([^}]*)\bipcRenderer\b([^}]*)\} from 'electron'/
+    if (!from.test(code)) throw new Error('kertas-quiet-bridge: the bridge no longer imports ipcRenderer this way')
+    const next = code.replace(
+      from,
+      (_m, a: string, b: string) => `import {${a}ipcRenderer as kertasIpc${b}} from 'electron'
+const kertasQuiet = ${QUIET}
+const ipcRenderer = new Proxy(kertasIpc, {
+  get(target, key) {
+    const real = Reflect.get(target, key)
+    if (typeof real !== 'function') return real
+    return (channel: string, ...rest: unknown[]) => {
+      // (an assistant channel whose name was taken out of the tables arrives as undefined)
+      if (typeof channel !== 'string' || kertasQuiet.test(channel)) {
+        return key === 'invoke' ? Promise.resolve(undefined) : key === 'sendSync' ? undefined : target
+      }
+      return (real as (...args: unknown[]) => unknown).call(target, channel, ...rest)
+    }
+  },
+}) as typeof kertasIpc`,
+    )
+    // the channel names the bridge spells out itself go too
+    return { code: next.replace(/'(?:ai|kb|project):[\w-]+'/g, 'undefined'), map: null }
+  },
+})
+
+// The assistant's part of the main-process code of the spreadsheet and PDF editors:
+// the function that sets up the assistant's handlers does nothing, and the tables of
+// channel names lose the assistant's entries, so neither the handlers nor the names
+// are in the build.
+const SHEETS_MAIN = /[\\/]sheets[\\/]src[\\/]main[\\/]sheets-main\.ts$/
+const CHANNEL_TABLES = /[\\/](?:sheets[\\/]src[\\/]shared[\\/]ipc-channels|pdf[\\/]src[\\/]shared[\\/]ipc)\.ts$/
+export const kertasNoAiMain = (): Plugin => ({
+  name: 'kertas-no-ai-main',
+  enforce: 'pre',
+  transform(code, id) {
+    const file = id.split('?')[0]
+    if (CHANNEL_TABLES.test(file)) {
+      return { code: code.replace(/^[ \t]*\w+: '(?:ai|kb|project):[\w-]+',[ \t]*\n/gm, ''), map: null }
+    }
+    if (!SHEETS_MAIN.test(file)) return null
+    let next = code
+    for (const name of ['registerSheetsAiIpc', 'registerProjectIpc']) {
+      const head = `export function ${name}(): void {\n`
+      const from = next.indexOf(head)
+      const to = from < 0 ? -1 : next.indexOf('\n}\n', from)
+      if (to < 0) throw new Error(`kertas-no-ai-main: ${name} is not where it was`)
+      next = `${next.slice(0, from + head.length)}${next.slice(to + 1)}`
+    }
+    return { code: next, map: null }
+  },
+})
diff --git a/apps/kertas-file-button.tsx b/apps/kertas-file-button.tsx
new file mode 100644
index 0000000..0737698
