--- /dev/null
+++ b/apps/pdf/src/renderer/kertas/stamps.ts
@@ -0,0 +1,69 @@
+// Rubber stamps (APPROVED, PAID, DRAFT...), as Kertas's own PDF editor has them. A stamp
+// is drawn as a picture and placed like an inserted picture: it follows the pointer, a
+// click drops it, and it can be moved, resized or deleted until the file is saved.
+import type { SignatureData } from '../../shared/ipc'
+
+export interface StampKind {
+  id: string
+  label: string
+  color: string
+}
+
+export const STAMPS: StampKind[] = [
+  { id: 'approved', label: 'APPROVED', color: '#16a34a' },
+  { id: 'rejected', label: 'REJECTED', color: '#dc2626' },
+  { id: 'paid', label: 'PAID', color: '#16a34a' },
+  { id: 'received', label: 'RECEIVED', color: '#2563eb' },
+  { id: 'draft', label: 'DRAFT', color: '#2563eb' },
+  { id: 'confidential', label: 'CONFIDENTIAL', color: '#dc2626' },
+  { id: 'for-review', label: 'FOR REVIEW', color: '#d97706' },
+  { id: 'final', label: 'FINAL', color: '#7c3aed' },
+  { id: 'copy', label: 'COPY', color: '#475569' },
+]
+
+/** Drawn at this many pixels per PDF point, so the stamp stays sharp when printed */
+export const STAMP_PX_PER_PT = 4
+
+const FONT = "'Inter Variable', 'Segoe UI', Arial, sans-serif"
+
+/** The stamp as a PNG: the label in bold capitals inside a rounded frame, with who
+ *  stamped it and when on a second line */
+export function renderStamp(kind: StampKind, by: string, when = new Date()): Extract<SignatureData, { kind: 'image' }> {
+  const k = STAMP_PX_PER_PT
+  const labelPx = 18 * k
+  const subPx = 7 * k
+  const date = when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
+  const sub = by ? `${by}, ${date}` : date
+  const probe = document.createElement('canvas').getContext('2d')!
+  probe.font = `800 ${labelPx}px ${FONT}`
+  const labelW = probe.measureText(kind.label).width
+  probe.font = `600 ${subPx}px ${FONT}`
+  const subW = probe.measureText(sub).width
+  const padX = 9 * k
+  const padY = 5 * k
+  const border = 2.2 * k
+  const width = Math.ceil(Math.max(labelW, subW) + padX * 2)
+  const height = Math.ceil(labelPx + subPx + padY * 2 + 2 * k)
+  const canvas = document.createElement('canvas')
+  canvas.width = width
+  canvas.height = height
+  const ctx = canvas.getContext('2d')!
+  ctx.strokeStyle = kind.color
+  ctx.fillStyle = kind.color
+  ctx.lineWidth = border
+  const r = 5 * k
+  const h = border / 2
+  ctx.beginPath()
+  ctx.roundRect(h, h, width - border, height - border, r)
+  ctx.globalAlpha = 0.07
+  ctx.fill()
+  ctx.globalAlpha = 0.95
+  ctx.stroke()
+  ctx.textAlign = 'center'
+  ctx.textBaseline = 'alphabetic'
+  ctx.font = `800 ${labelPx}px ${FONT}`
+  ctx.fillText(kind.label, width / 2, padY + labelPx * 0.86)
+  ctx.font = `600 ${subPx}px ${FONT}`
+  ctx.fillText(sub, width / 2, height - padY - subPx * 0.2)
+  return { kind: 'image', image: canvas.toDataURL('image/png').split(',')[1] ?? '', width, height }
+}
