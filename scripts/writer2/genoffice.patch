--- /dev/null
+++ b/packages/electron-utils/src/data-dir.ts
@@ -0,0 +1,14 @@
+import { app } from 'electron'
+
+/** Where the editors keep their own files (recent list, settings, templates).
+ * A host that keeps files of its own in userData points this at a folder of
+ * the editors' own, so the two never share a file name. */
+let dir: string | null = null
+
+export function setDataDir(path: string): void {
+  dir = path
+}
+
+export function dataDir(): string {
+  return dir ?? app.getPath('userData')
+}
