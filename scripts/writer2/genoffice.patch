@@ -0,0 +1,73 @@
+// Entry used when Kertas Office hosts this editor: the same main-process code,
+// without starting an app of its own.
+export {
+  configureDocsRuntime,
+  registerDocsIpc,
+  registerProjectIpc,
+  createDocsWindow,
+  setDocsShellHooks,
+  setDocsShellWindow,
+  buildDocsMenu,
+  openExternalDocx,
+  markDocsNewBlank,
+} from './docs-main'
+export { installRendererProtocol } from '@genoffice/electron-utils'
+export { installContextMenu } from '@genoffice/electron-utils'
+export {
+  RENDERER_SCHEME_PRIVILEGE,
+  DOCX_MEDIA_SCHEME_PRIVILEGE,
+} from '@genoffice/electron-utils/renderer-scheme'
+
+import { app as electronApp, type WebContents } from 'electron'
+import { installContextMenu as installMenu, contextMenuLabels } from '@genoffice/electron-utils'
+import { getUiLang, normalizeLang, setUiLang } from '@genoffice/i18n'
+
+/** right-click menus for the editor's own windows only, in the app's language */
+export function installDocsContextMenu(only: (contents: WebContents) => boolean): void {
+  installMenu(electronApp, () => contextMenuLabels(getUiLang()), only)
+}
+
+export function setDocsLanguage(locale: string): void {
+  setUiLang(normalizeLang(locale))
+}
+export { setDataDir } from '@genoffice/electron-utils/data-dir'
+export { setDocsMenuGate } from './docs-main'
+export { queueDocsResultDoc } from './docs-main'
+
+import { readFileSync } from 'node:fs'
+import { convertPdfToDocx } from '../../../../packages/pdf2docx/src'
+import type { PdfiumModule } from '../../../../packages/pdf2docx/src'
+
+let pdfium: Promise<PdfiumModule> | null = null
+
+/** PDF bytes to Word bytes, on this computer. `wasmPath` is the PDFium engine file. */
+export async function convertPdfBytesToDocx(
+  pdf: Uint8Array,
+  wasmPath: string,
+  onProgress?: (page: number, total: number) => void,
+): Promise<Uint8Array> {
+  pdfium ??= (async () => {
+    const { init } = (await import('@embedpdf/pdfium')) as unknown as {
+      init(overrides: object): Promise<object>
+    }
+    const raw = readFileSync(wasmPath)
+    const wasmBinary = raw.buffer.slice(raw.byteOffset, raw.byteOffset + raw.byteLength)
+    const wrapped = (await init({ wasmBinary, thisProgram: 'kertas-pdf' })) as { pdfium?: unknown }
+    const m = (wrapped.pdfium ?? wrapped) as PdfiumModule & { _PDFiumExt_Init(): void }
+    m._PDFiumExt_Init()
+    return m
+  })()
+  const result = await convertPdfToDocx(pdf, {
+    pdfium: await pdfium,
+    ...(onProgress ? { onProgress } : {}),
+  })
+  return result.docx
+}
+export {
+  createDocsView,
+  requestDocsClose,
+  docsQueryDirty,
+  setActiveDocsResolver,
+  setDocsFileSavedHook,
+  setDocsFileOpenedHook,
+} from './docs-main'
