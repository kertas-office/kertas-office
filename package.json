{
  "name": "kertas-office",
  "version": "1.0.0",
  "description": "Free, open-source office suite: documents, spreadsheets and PDFs",
  "homepage": "https://kertasoffice.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kertas-office/kertas-office.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env KERTAS_DEV_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.cjs",
    "site": "node website/build.mjs",
    "dist": "vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "release": "vite build && electron-builder --config electron-builder.config.cjs --publish always",
    "postinstall": "node scripts/patch-deps.cjs"
  },
  "keywords": ["office-suite", "docx", "xlsx", "pdf-editor", "electron", "offline"],
  "bugs": {
    "url": "https://github.com/kertas-office/kertas-office/issues"
  },
  "author": {
    "name": "Kertas Office contributors"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@e965/xlsx": "^0.20.3",
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/arimo": "^0.4.3",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/caladea": "^0.4.2",
    "@expo-google-fonts/carlito": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/cousine": "^0.4.3",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo-google-fonts/libre-baskerville": "^0.4.3",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/manjari": "^0.4.1",
    "@expo-google-fonts/merriweather": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
