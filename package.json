    "cross-env": "^10.1.0",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "docx": "^9.15.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "exceljs": "^4.4.0",
    "fontkit": "^2.0.4",
    "jszip": "^3.10.2",
    "lucide": "^1.70.0",
    "node-forge": "^1.4.3",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.5.438",
    "png2icons": "^2.0.1",
    "superdoc": "1.47.2",
    "temml": "^0.14.0",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "productName": "Kertas Office",
  "type": "module",
  "desktopName": "kertas-office.desktop",
  "overrides": {
    "superdoc": {
      "pdfjs-dist": "$pdfjs-dist"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  }
}
